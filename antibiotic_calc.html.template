      const routeData = dil[activeRouteKey];
      if(routeData && routeData.solvent_options && routeData.solvent_options[activeVialIdx]){
        const v = routeData.solvent_options[activeVialIdx];
        // Растворитель и характеристики флакона приходят из БД: узлы + textContent.
        const injBlock = document.createElement('div');
        injBlock.className = 'rx-inj-block';
        const injLabel = document.createElement('b');
        injLabel.textContent = 'Solutio pro injectione:';
        injBlock.append(injLabel, document.createElement('br'));
        const mlForDose = (v.final_concentration_mg_ml||v.final_concentration_units_ml) ? (singleMg/(v.final_concentration_mg_ml||v.final_concentration_units_ml)).toFixed(2)+' ml' : '—';
        [
          v.solvent+' — '+v.solvent_ml+' ml',
          'Vial: '+(v.vial_mg?v.vial_mg+' mg':(v.vial_units?formatUnits(v.vial_units)+' ED':'')),
          'Concentratio finalis: '+(v.final_concentration_mg_ml?v.final_concentration_mg_ml+' mg/ml':(v.final_concentration_units_ml?formatUnits(v.final_concentration_units_ml)+' ED/ml':'')),
          'Volumen pro dosi: '+mlForDose
        ].forEach((text, index)=>{
          if(index > 0) injBlock.appendChild(document.createElement('br'));
          injBlock.appendChild(document.createTextNode(text));
        });
        injEl.appendChild(injBlock);
      }
    }
  }
}
