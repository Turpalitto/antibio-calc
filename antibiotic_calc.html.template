function getActiveRegimen(){
  if(!activeDrug) return null;
  const regimens = (activeDrug.regimens || []).filter(r=>r.age_group === activeAge || r.age_group === 'all');
  // Раньше здесь был откат на regimens[0], то есть при отсутствии режима для
  // выбранного возраста молча возвращался режим ДРУГОЙ возрастной группы —
  // взрослому доставалась детская доза и наоборот. Лучше отсутствие расчёта,
  // чем правдоподобное неверное число.
  if(regimens.length === 0) return null;
  return regimens[activeRegimenIdx] || regimens[0];
}
function computeDose(reg, w, unit){
  // Источник-истинный приоритет (RC-030/denominator_time): КР чаще пишет РАЗОВУЮ
  // дозу, поэтому при наличии single_dose_mg считаем от неё (single × freq),
  // а stored daily (perKg/fixed) используем только для кросс-проверки.
  let singleMg = 0, dailyMg = 0, capped = false, needWeight = false, inconsistent = false;
  const perKg = reg.dose_mg_kg_day;
  const fixed = reg.dose_mg_day_fixed;
  const single = reg.single_dose_mg;
  const maxDaily = reg.max_daily_mg;
  if(single != null && reg.freq_per_day){
    singleMg = single;
    dailyMg = single * reg.freq_per_day;
    const stored = (perKg != null && w > 0) ? w * perKg : (fixed != null ? fixed : null);
    if(stored != null && Math.abs(stored - dailyMg) > 0.05 * Math.abs(dailyMg) + 1) inconsistent = true;
  } else if(perKg != null){
    if(w > 0){ dailyMg = w * perKg; }
    else { needWeight = true; }
  } else if(fixed != null){
    dailyMg = fixed;
  } else if(single != null){
    singleMg = single;
    dailyMg = single * (reg.freq_per_day || 1);
  }
  if(maxDaily != null && dailyMg > maxDaily){
    dailyMg = maxDaily;
    capped = true;
    // Разовая доза обязана пересчитываться вместе с суточной. Иначе рецепт
    // печатал «1500 мг 4 р/д» при максимуме 4000 мг/сут, то есть инструкцию,
    // которая на 50% превышает заявленный потолок.
    if(singleMg > 0) singleMg = dailyMg / (reg.freq_per_day || 1);
  }
  if(singleMg === 0 && reg.freq_per_day) singleMg = dailyMg / reg.freq_per_day;
  // Режим без единого дозового поля: раньше это молча превращалось в «0 мг»
  // на экране. Ноль выглядит как доза, поэтому absence должен быть явным.
  const noDose = perKg == null && fixed == null && single == null;
  return {singleMg, dailyMg, capped, needWeight, inconsistent, noDose, unit: unit || 'мг'};
}
// Форматирование дозы с учётом единиц (мг или ЕД)
function fmtDose(val, unit){
  if(unit === 'ЕД') return formatUnits(Math.round(val)) + ' ЕД';
  return Math.round(val) + ' мг';
}
function doseUnitOf(ref){
  return (ref && ref.dose_unit) ? ref.dose_unit : 'мг';
}
function showNoCalculation(message){
  $('res-po').classList.add('hidden');
  $('res-inj').classList.add('hidden');
  $('dilution-block').classList.add('hidden');
  $('combo-block').classList.add('hidden');
  $('res-no-regimen').classList.remove('hidden');
  $('no-regimen-text').textContent = message;
}
function calculate(){
  if(!activeDrug) return;
  const w = parseFloat($('weight').value);
  const refs = getDrugRefs(activeDrug);
  const mainRef = DB.drugs_reference[refs[0]];
  if(!mainRef) return;
  const form = mainRef.forms[activeFormIdx];
  const reg = getActiveRegimen();
  if(!reg){
    // Режимов для выбранного возраста нет: показываем причину и убираем
    // результаты, чтобы на экране не осталось чужой дозы.
    const present = Array.from(new Set((activeDrug.regimens||[]).map(r=>r.age_group))).join(', ') || '—';
    showNoCalculation(
      'Для препарата '+(mainRef.inn||refs[0])+' нет схемы дозирования на возрастную группу «'
      +activeAge+'». В КР указаны только: '+present+'.');
    return;
  }
  const unit = doseUnitOf(mainRef);
  const {singleMg, dailyMg, capped, needWeight, inconsistent, noDose} = computeDose(reg, w, unit);
  if(noDose){
    // Доза есть только в свободном тексте КР — число выводить нельзя.
    showNoCalculation(
      'Для препарата '+(mainRef.inn||refs[0])+' в КР не указана числовая доза — только текстовое описание. '
      +'См. примечание к режиму.');
    return;
  }
  $('res-no-regimen').classList.add('hidden');
  updateWeightWarn(needWeight);

  $('combo-block').classList.add('hidden');
  $('combo-block').innerHTML = '';

  const isPO = currentRouteGroup === 'po';
  const isInj = currentRouteGroup === 'im' || currentRouteGroup === 'iv';

  if(isPO){
    $('res-po').classList.remove('hidden');
    $('res-inj').classList.add('hidden');
    $('dilution-block').classList.add('hidden');
    renderPO(reg, form, mainRef, w, singleMg, dailyMg, capped, inconsistent);
    renderReconstitution(form);
  } else if(isInj){
    $('res-po').classList.add('hidden');
    $('res-inj').classList.remove('hidden');
    $('dilution-block').classList.remove('hidden');
    $('reconstitution-block').classList.add('hidden');
    renderInjection(reg, form, mainRef, w, singleMg, dailyMg, capped, inconsistent);
  }

  if(refs.length > 1){
    renderComboComponents(refs.slice(1), reg, w);
  }

  $('res-note').textContent = activeDrug.indication_note || (activeLine && activeLine.line_label) || '';
  renderDrugMeta(mainRef, reg);
}
// Длительность курса: исходный текст КР никогда не выбрасывается (INV-09), но
// раньше к нему механически дописывалось «дней», из-за чего «однократно»
// превращалось в «Курс: однократно дней», а parseInt('10-14') молча давал 10.
// Теперь фраза строится по разобранному профилю duration_parsed, а неразобранный
// текст печатается дословно.
function formatDuration(reg){
  if(!reg) return '—';
  const parsed = reg.duration_parsed || null;
  const raw = reg.duration_days;
  const has = (v)=>typeof v === 'number' && isFinite(v);
  if(parsed && parsed.kind === 'SINGLE_DOSE') return 'однократно';
  if(parsed && parsed.kind === 'LIFELONG') return 'пожизненно';
  if(parsed && parsed.unit === 'day'){
    if(parsed.kind === 'FIXED' && has(parsed.value_min)) return parsed.value_min+' дней';
    if(parsed.kind === 'RANGE' && has(parsed.value_min) && has(parsed.value_max)) return parsed.value_min+'–'+parsed.value_max+' дней';
    if(parsed.kind === 'AT_LEAST' && has(parsed.value_min)) return 'не менее '+parsed.value_min+' дней';
    if(parsed.kind === 'AT_MOST' && has(parsed.value_max)) return 'до '+parsed.value_max+' дней';
  }
  if(parsed && parsed.unit === 'hour' && parsed.kind === 'AT_MOST' && has(parsed.value_max)) return 'не более '+parsed.value_max+' ч';
  if(parsed && parsed.unit === 'month' && has(parsed.value_min)){
    return (parsed.kind === 'AT_LEAST' ? 'не менее ' : '')+parsed.value_min+' мес';
  }
  if(parsed && parsed.unit === 'week' && parsed.kind === 'FIXED' && has(parsed.value_min)) return parsed.value_min+' нед';
  if(parsed && parsed.kind === 'DOSE_COUNT' && has(parsed.value_min)) return parsed.value_min+' приём(а)';
  if(raw === null || raw === undefined || String(raw).trim() === '') return '—';
  return String(raw);
}
// Количество дней курса — только когда оно действительно известно. Для диапазона
// возвращает обе границы, чтобы рецептурный блок не печатал одно неверное число.
function courseDayBounds(reg){
  const parsed = reg && reg.duration_parsed;
  if(!parsed || parsed.unit !== 'day') return null;
  if(parsed.kind === 'FIXED' && typeof parsed.value_min === 'number') return [parsed.value_min, parsed.value_min];
  if(parsed.kind === 'RANGE' && typeof parsed.value_min === 'number' && typeof parsed.value_max === 'number'){
    return [parsed.value_min, parsed.value_max];
  }
  return null;
}
function renderCourseTotals(reg, freqPerDay, tabsPerDose, unitLabel){
  const bounds = courseDayBounds(reg);
  if(!bounds || !(freqPerDay > 0) || !(tabsPerDose > 0)) return '';
  const perDose = Math.ceil(tabsPerDose);
  const low = bounds[0] * freqPerDay * perDose;
  const high = bounds[1] * freqPerDay * perDose;
  const total = low === high ? String(low) : (low+'–'+high);
  const span = bounds[0] === bounds[1] ? String(bounds[0]) : (bounds[0]+'–'+bounds[1]);
  return '<div class="rx-dtd">(для курса '+span+' дн: '+total+' '+unitLabel+')</div>';
}
function renderPO(reg, form, ref, w, singleMg, dailyMg, capped, inconsistent){
  const unit = doseUnitOf(ref);
  const concMgPerMl = form.concentration_mg_per_ml || 0;
  const isSolid = ['tablet','capsule'].includes(form.form_type);
  if(isSolid || (w >= 40 && concMgPerMl === 0)){
    $('po-ml').textContent = unit === 'ЕД' ? formatUnits(Math.round(singleMg)) : Math.round(singleMg);
    $('po-unit').textContent = unit;
    $('po-tabs').textContent = unit === 'ЕД' ? '' : formatTablets(singleMg, form);
    $('po-instruction').innerHTML = '<i class="fas fa-pills mr-2 text-blue-300"></i>Принимать по <b>'+fmtDose(singleMg, unit)+'</b> '+reg.freq_per_day+' р/д '+(form.concentration||'');
  } else if(concMgPerMl > 0) {
    const ml = singleMg / concMgPerMl;
    $('po-ml').textContent = ml.toFixed(1);
    $('po-unit').textContent = 'мл';
    $('po-tabs').textContent = '';
    $('po-instruction').innerHTML = '<i class="fas fa-flask mr-2 text-blue-300"></i>Давать по <b>'+ml.toFixed(1)+' мл</b> суспензии ('+form.concentration+') '+reg.freq_per_day+' р/д';
  } else {
    // Fail-closed: концентрация неизвестна — объём НЕ выдумываем (был 0.0 мл).
    $('po-ml').textContent = '—';
    $('po-unit').textContent = 'мл';
    $('po-tabs').textContent = '';
    $('po-instruction').innerHTML = '<i class="fas fa-exclamation-triangle mr-2 text-amber-300"></i>Объём не рассчитан: нет данных о концентрации формы «'+(form.concentration||form.form_type)+'». Дозируйте по массе: <b>'+fmtDose(singleMg, unit)+'</b> '+reg.freq_per_day+' р/д';
  }
  $('po-mg').textContent = fmtDose(singleMg, unit);
  $('po-day').textContent = fmtDose(dailyMg, unit);
  $('po-dur').textContent = formatDuration(reg);

  const rangeEl = $('po-range');
  const uk = unit + '/кг/сут';
  if(reg.dose_range_mg_kg_day && reg.dose_range_mg_kg_day.length === 2){
    rangeEl.classList.remove('hidden');
    rangeEl.textContent = 'Диапазон по КР: '+reg.dose_range_mg_kg_day[0]+'-'+reg.dose_range_mg_kg_day[1]+' '+uk;
  } else if(reg.dose_mg_kg_day){
    rangeEl.classList.remove('hidden');
    rangeEl.textContent = 'Доза по КР: '+reg.dose_mg_kg_day+' '+uk;
  } else rangeEl.classList.add('hidden');

  const warnEl = $('po-max-warn');
  if(inconsistent){
    warnEl.querySelector('span').textContent = 'Данные БД несогласованы: разовая × кратность ≠ суточной. Расчёт выполнен по разовой дозе из КР — требуется проверка.';
    warnEl.classList.remove('hidden');
  } else if(capped){
    warnEl.querySelector('span').textContent = 'Превышена max суточная доза — снижено до '+fmtDose(reg.max_daily_mg, unit)+'/сут';
    warnEl.classList.remove('hidden');
  } else warnEl.classList.add('hidden');
}
// Единственный источник «прочности таблетки». Для композитной формы «875+125 мг»
// parseFloat останавливается на «+» и даёт 875 — основной компонент; регулярка
// /(\d+)\s*мг/ вместо этого взяла бы последнее число перед «мг» (125, клавуланат)
// и напечатала бы «7 таб 125 мг» на дозу 875 мг, тогда как печатная форма на том
// же экране считала 1 таблетку. Оба пути обязаны делить на одно и то же.
function tabletStrengthMg(form){
  if(!form || !['tablet','capsule'].includes(form.form_type)) return null;
  const strength = parseFloat(form.concentration);
  return (isFinite(strength) && strength > 0) ? strength : null;
}
function formatTablets(mg, form){
  const strength = tabletStrengthMg(form);
  if(!strength) return '';
  const tabs = mg / strength;
  if(tabs === Math.round(tabs)) return '('+tabs+' таб '+strength+' мг)';
  const half = Math.round(tabs*2)/2;
  return '(~'+half+' таб '+strength+' мг)';
}
function renderReconstitution(form){
  const block = $('reconstitution-block');
  const content = $('reconstitution-content');
  if(form.reconstitution){
    block.classList.remove('hidden');
    const r = form.reconstitution;
    let html = '<div class="font-bold text-slate-800 dark:text-slate-200 mb-1">Приготовление '+form.concentration+':</div>';
    html += '<div class="text-slate-600 dark:text-slate-400 mb-2">Растворитель: <b>'+r.solvent+'</b> — '+r.solvent_ml+' мл (итог: '+r.final_volume_ml+' мл)</div>';
    html += '<ol class="steps">';
    r.steps.forEach(s=>{ html += '<li class="step"><span>'+s+'</span></li>'; });
    html += '</ol>';
    if(r.storage) html += '<div class="mt-2 text-amber-700 dark:text-amber-400 font-bold bg-amber-50 dark:bg-amber-900/20 rounded-lg px-3 py-2"><i class="fas fa-snowflake mr-1"></i>'+r.storage+'</div>';
    content.innerHTML = html;
  } else {
    block.classList.add('hidden');
  }
}
function renderInjection(reg, form, ref, w, singleMg, dailyMg, capped, inconsistent){
