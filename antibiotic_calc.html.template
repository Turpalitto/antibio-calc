function sameStringArray(a,b){
  return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((value,index)=>value === b[index]);
}
function resolveCalculatorBinding(binding){
  if(!binding || typeof binding !== 'object') throw new Error('Отсутствует calculator_binding');
  const required = ['disease_id','scenario_id','line_number','route'];
  if(required.some(key=>binding[key] === undefined || binding[key] === null || binding[key] === '')) throw new Error('Неполный calculator_binding');
  const hasDrug = typeof binding.drug_ref === 'string' && binding.drug_ref.length > 0;
  const hasCombo = Array.isArray(binding.combo_ref) && binding.combo_ref.length > 0;
  if(hasDrug === hasCombo) throw new Error('Привязка должна содержать ровно один drug_ref или combo_ref');
  const hasLabel = typeof binding.regimen_label === 'string' && binding.regimen_label.length > 0;
  const hasIndex = Number.isInteger(binding.regimen_index) && binding.regimen_index >= 0;
  if(!hasLabel && !hasIndex) throw new Error('Требуется regimen_label или точный regimen_index');
  const disease = (DB.recommendations||[]).find(item=>item.id === binding.disease_id);
  if(!disease) throw new Error('Неизвестный disease_id');
  if(disease.calculation_blocked) throw new Error('Расчёт для этой нозологии заблокирован до верификации актуального источника');
  const scenario = (disease.scenarios||[]).find(item=>item.id === binding.scenario_id);
  if(!scenario) throw new Error('scenario_id не принадлежит disease_id');
  if(scenario.age_group !== 'all' && scenario.age_group !== activeAge) throw new Error('scenario_id не подходит возрастной группе');
  const lineMatches = (scenario.lines||[]).filter(item=>item.line_number === binding.line_number);
  const matches = [];
  lineMatches.forEach(line=>(line.drugs||[]).forEach(drug=>{
    const identityMatches = hasDrug ? drug.drug_ref === binding.drug_ref : sameStringArray(drug.combo_ref,binding.combo_ref);
    const routeMatches = Array.isArray(drug.route) && drug.route.includes(binding.route);
    if(identityMatches && routeMatches) matches.push({line,drug});
  }));
  if(matches.length !== 1) throw new Error(matches.length ? 'Неоднозначный calculator_binding' : 'Препарат/комбинация/route не совпадают со встроенной БД');
  const drug = matches[0].drug;
  const eligible = ageEligibleRegimens(drug);
  if(eligible.length === 0) throw new Error('Встроенная БД не содержит режима дозирования для возрастной группы '+ageGroupLabel(activeAge));
  let regimen = null;
  if(hasIndex){
    regimen = (drug.regimens||[])[binding.regimen_index];
    if(!regimen || !eligible.includes(regimen)) throw new Error('regimen_index неизвестен или не подходит возрастной группе');
  }
  if(hasLabel){
    const labels = eligible.filter(reg=>reg.regimen_label === binding.regimen_label);
    if(labels.length !== 1) throw new Error(labels.length ? 'Неоднозначный regimen_label' : 'regimen_label не найден во встроенной БД');
    if(regimen && regimen !== labels[0]) throw new Error('regimen_label и regimen_index не совпадают');
    regimen = labels[0];
  }
  const routeMap = {per_os:'po',iv:'iv',im:'im'};
  if(!routeMap[binding.route]) throw new Error('Неизвестный route в calculator_binding');
  const routeGroup = routeMap[binding.route];
  const mainRef = DB.drugs_reference[getDrugRefs(drug)[0]];
  if(!mainRef) throw new Error('drug_ref отсутствует во встроенном drugs_reference');
  const forms = mainRef.forms || [];
  const routeSupported = routeGroup === 'po'
    ? forms.some(form=>['tablet','capsule','suspension','syrup','granules'].includes(form.form_type) || (form.form_type === 'powder_for_suspension' && form.concentration_mg_per_ml != null))
    : routeGroup === 'im'
      ? !!(mainRef.dilution && mainRef.dilution.im && forms.some(form=>['powder_for_suspension','powder_for_injection','solution_im'].includes(form.form_type)))
      : !!(mainRef.dilution && (mainRef.dilution.iv_bolus || mainRef.dilution.iv_infusion) && forms.some(form=>['powder_for_suspension','powder_for_injection','solution_iv'].includes(form.form_type)));
  if(!routeSupported) throw new Error('route не поддержан формами во встроенной БД');
  const line = matches[0].line;
  return {
    disease, scenario, line, drug,
    scenarioIndex:(disease.scenarios||[]).indexOf(scenario),
    lineIndex:(scenario.lines||[]).indexOf(line),
    drugIndex:(line.drugs||[]).indexOf(drug),
    regimenIndex:eligible.indexOf(regimen), routeGroup
  };
}
function applyPersonalCandidate(index, envelope){
  try{
    const candidate = personalCandidates[index];
    if(!candidate || candidate.governance_status !== 'OWNER_REVIEWED_EXPERIMENTAL') throw new Error('Кандидат недоступен или потерял governance status');
    const resolved = resolveCalculatorBinding(candidate.calculator_binding);
    activeDisease = resolved.disease;
    activeScenario = resolved.scenario;
    activeLine = resolved.line;
    activeDrug = resolved.drug;
    activeFormIdx = 0; activeRegimenIdx = resolved.regimenIndex; activeRouteKey = null; activeVialIdx = 0;
    $('active-disease').classList.remove('hidden'); $('empty-state').classList.add('hidden');
    $('active-title').textContent = activeDisease.name;
    $('active-mkb').textContent = 'МКБ-10: '+activeDisease.mkb10.join(', ');
    $('active-cr').textContent = 'КР #'+activeDisease.cr_id+' · '+activeDisease.cr_year;
    $('active-indications').textContent = activeDisease.indications ? 'Показания: '+activeDisease.indications.join('; ') : '';
    $('scenario-step').classList.remove('hidden'); $('drug-step').classList.remove('hidden'); $('form-step').classList.remove('hidden'); $('result-step').classList.remove('hidden');
    renderScenarios(resolved.scenario, resolved.lineIndex, resolved.drugIndex, resolved.routeGroup, resolved.regimenIndex);
    renderPersonalTrace(candidate, envelope);
    updateHash();
    setPersonalStatus('ready', 'Кандидат применён через встроенную БД; расчёт выполнен штатными функциями');
  }catch(error){
    setPersonalStatus('blocked', 'BLOCKED: '+error.message+'; выбор калькулятора не изменён');
  }
}
function renderPersonalTrace(candidate, envelope){
  const content = $('personal-trace-content');
  content.innerHTML = '';
  const rows = [
    ['Governance', candidate.governance_status],
    ['Regimen / guideline', (candidate.regimen_id||'—')+' / '+(candidate.guideline_id||'—')],
