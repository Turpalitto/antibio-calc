    ['Рассмотрено / отклонено', JSON.stringify(candidate.alternatives_considered||candidate.alternatives||[])],
    ['Safety filters', JSON.stringify(candidate.safety_filters||candidate.safety||{})],
    ['Terminology mappings', JSON.stringify(candidate.terminology_mappings||[])],
    ['Engine stages', JSON.stringify((candidate.trace&&candidate.trace.stages)||(envelope&&envelope.trace&&envelope.trace.participating_stages)||[])],
    ['Request trace', JSON.stringify((envelope&&envelope.trace)||{})]
  ];
  rows.forEach(row=>{
    const div=document.createElement('div'), label=document.createElement('b'), value=document.createElement('span');
    label.textContent=row[0]+': '; value.textContent=row[1]; div.append(label,value); content.appendChild(div);
  });
  $('personal-trace-panel').classList.remove('hidden');
}
