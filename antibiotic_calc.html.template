// Режимы, допустимые для выбранной возрастной группы. Единственный источник
// правды об age_group: подстановка режима другой группы запрещена.
function ageEligibleRegimens(drug){
  return ((drug && drug.regimens) || []).filter(r=>r.age_group === activeAge || r.age_group === 'all');
}
function ageGroupLabel(a){
  return {neonate:'новорождённые', child:'дети', adult:'взрослые'}[a] || a || '—';
}
function getActiveRegimen(){
  if(!activeDrug) return null;
  const regimens = ageEligibleRegimens(activeDrug);
  // Нет режима для возрастной группы — возвращаем null. Подставлять режим
  // другой группы (например adult для ребёнка) нельзя: это тихая ошибка дозы.
  if(regimens.length === 0) return null;
  return regimens[activeRegimenIdx] || regimens[0];
}
function ageRegimenBlockReason(){
  if(!activeDrug) return '';
  if(ageEligibleRegimens(activeDrug).length) return '';
  const available = [...new Set((activeDrug.regimens || []).map(r=>r.age_group))];
  if(!available.length) return '';
  const key = getDrugRefs(activeDrug)[0];
  const name = ((DB.drugs_reference[key]||{}).inn) || key;
  return 'РАСЧЁТ ЗАБЛОКИРОВАН: для препарата «'+name+'» в БД нет ни одной схемы дозирования для возрастной группы «'+ageGroupLabel(activeAge)+'» (в БД есть только: '+available.map(ageGroupLabel).join(', ')+'). Расчёт НЕ является пациент-специфичным и не может быть сохранён, скопирован или распечатан. Выберите препарат/сценарий с режимом для «'+ageGroupLabel(activeAge)+'» либо явно смените возрастную группу.';
}
function requireActiveRegimen(action){
  const reg = getActiveRegimen();
  if(!reg) toast((action || 'Действие')+' невозможно: для выбранной возрастной группы нет схемы дозирования');
  return reg;
}
function computeDose(reg, w, unit){
  // Источник-истинный приоритет (RC-030/denominator_time): КР чаще пишет РАЗОВУЮ
  // дозу, поэтому при наличии single_dose_mg считаем от неё (single × freq),
  // а stored daily (perKg/fixed) используем только для кросс-проверки.
  let singleMg = 0, dailyMg = 0, capped = false, needWeight = false, inconsistent = false;
  const perKg = reg.dose_mg_kg_day;
  const fixed = reg.dose_mg_day_fixed;
  const single = reg.single_dose_mg;
  const maxDaily = reg.max_daily_mg;
  if(single != null && reg.freq_per_day){
    singleMg = single;
    dailyMg = single * reg.freq_per_day;
    const stored = (perKg != null && w > 0) ? w * perKg : (fixed != null ? fixed : null);
    if(stored != null && Math.abs(stored - dailyMg) > 0.05 * Math.abs(dailyMg) + 1) inconsistent = true;
  } else if(perKg != null){
    if(w > 0){ dailyMg = w * perKg; }
    else { needWeight = true; }
  } else if(fixed != null){
    dailyMg = fixed;
  } else if(single != null){
    singleMg = single;
    dailyMg = single * (reg.freq_per_day || 1);
  }
  if(maxDaily != null && dailyMg > maxDaily){
    dailyMg = maxDaily;
    capped = true;
    // Разовая доза из single_dose_mg жила своей веткой и потолок не затрагивала:
    // при single × freq > max_daily_mg на экране и в рецепте оставалась
    // недопустимо большая разовая доза. Срезаем её тем же потолком.
    if(singleMg > 0) singleMg = reg.freq_per_day ? maxDaily / reg.freq_per_day : maxDaily;
  }
  if(singleMg === 0 && reg.freq_per_day) singleMg = dailyMg / reg.freq_per_day;
  return {singleMg, dailyMg, capped, needWeight, inconsistent, unit: unit || 'мг'};
}
// Форматирование дозы с учётом единиц (мг или ЕД)
function fmtDose(val, unit){
  if(unit === 'ЕД') return formatUnits(Math.round(val)) + ' ЕД';
  return Math.round(val) + ' мг';
}
function doseUnitOf(ref){
  return (ref && ref.dose_unit) ? ref.dose_unit : 'мг';
}
const DOSE_BLOCK_CLASS = 'rounded-2xl border-2 border-red-500 bg-red-50 dark:bg-red-950/40 px-4 py-4 text-[12px] font-black text-red-800 dark:text-red-200 whitespace-pre-line';
function showDoseBlock(text){
