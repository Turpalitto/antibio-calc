function renderScenarios(preferredScenario, preferredLineIndex, preferredDrugIndex, preferredRoute, preferredRegimenIdx){
  const list = $('scenario-list');
  list.innerHTML = '';
  let firstVisible = null, firstVisibleCard = null, preferredCard = null;
  activeDisease.scenarios.forEach((s, idx)=>{
    const ageMatch = s.age_group === 'all' || s.age_group === activeAge;
    const card = document.createElement('div');
    card.className = 'scenario-card drug-card premium-card p-3 md:p-4'+(ageMatch?'':' opacity-50');
    card.dataset.idx = idx;
    // Название сценария приходит из БД (извлечение из PDF КР): собираем через
    // textContent, иначе значение из БД становится исполняемым HTML (stored XSS).
    const row = document.createElement('div');
    row.className = 'flex justify-between items-center';
    const col = document.createElement('div');
    const scenarioName = document.createElement('div');
    scenarioName.className = 'font-bold text-slate-800 dark:text-slate-200 text-sm';
    scenarioName.textContent = s.name;
    col.appendChild(scenarioName);
    if(!ageMatch){
      const ageWarn = document.createElement('div');
      ageWarn.className = 'text-[10px] text-red-500 font-bold mt-1';
      ageWarn.textContent = 'Не подходит для выбранной возрастной группы';
      col.appendChild(ageWarn);
    }
    const chevron = document.createElement('i');
    chevron.className = 'fas fa-chevron-right text-slate-300';
    row.append(col, chevron);
    card.appendChild(row);
    card.onclick = ()=>selectScenario(s, card);
    list.appendChild(card);
    if(ageMatch && !firstVisible){ firstVisible = s; firstVisibleCard = card; }
    if(ageMatch && s === preferredScenario) preferredCard = card;
  });
  if(preferredCard) selectScenario(preferredScenario, preferredCard, preferredLineIndex, preferredDrugIndex, preferredRoute, preferredRegimenIdx);
  else if(firstVisible) selectScenario(firstVisible, firstVisibleCard);
}
function selectScenario(s, card, preferredLineIndex, preferredDrugIndex, preferredRoute, preferredRegimenIdx){
  activeScenario = s;
  document.querySelectorAll('#scenario-list .scenario-card').forEach(c=>c.classList.remove('active'));
  if(card) card.classList.add('active');
  $('drug-step').classList.remove('hidden');
  renderLines(preferredLineIndex, preferredDrugIndex, preferredRoute, preferredRegimenIdx);
  updateHash();
}
