// Единая точка отказа: любое из этих условий запрещает показ, сохранение,
// копирование и печать дозы. Fail closed.
function calculationBlockReason(w){
  const dbReason = dbBlockReason();
  if(dbReason) return 'РАСЧЁТ ЗАБЛОКИРОВАН: '+dbReason+'. Обратитесь к владельцу сборки БД.';
  const weightReason = weightBlockReason(w, activeAge);
  if(weightReason) return 'РАСЧЁТ ЗАБЛОКИРОВАН: '+weightReason;
  const ageReason = ageRegimenBlockReason();
  if(ageReason) return ageReason;
  return '';
}
function calculate(){
  if(!activeDrug) return;
  const w = parseFloat($('weight').value);
  const refs = getDrugRefs(activeDrug);
  const mainRef = DB.drugs_reference[refs[0]];
  if(!mainRef) return;
  const form = mainRef.forms[activeFormIdx];
  updateWeightWarn(false);
  const block = calculationBlockReason(w);
  if(block){
    // Ничего не показываем: ни дозы, ни объёма, ни препарата для печати.
    showDoseBlock(block);
    hideDoseResults();
    return;
  }
  hideDoseBlock();
  const reg = getActiveRegimen();
  if(!reg){ hideDoseResults(); return; }
  const unit = doseUnitOf(mainRef);
  const {singleMg, dailyMg, capped, needWeight, inconsistent} = computeDose(reg, w, unit);
  updateWeightWarn(needWeight);
  $('drug-meta').classList.remove('hidden');

  $('combo-block').classList.add('hidden');
  $('combo-block').innerHTML = '';

  const isPO = currentRouteGroup === 'po';
  const isInj = currentRouteGroup === 'im' || currentRouteGroup === 'iv';
  const isTopical = currentRouteGroup === 'topical';

  if(isPO || isTopical){
    $('res-po').classList.remove('hidden');
    $('res-inj').classList.add('hidden');
    $('dilution-block').classList.add('hidden');
    renderPO(reg, form, mainRef, w, singleMg, dailyMg, capped, inconsistent);
    renderReconstitution(form);
  } else if(isInj){
    $('res-po').classList.add('hidden');
    $('res-inj').classList.remove('hidden');
    $('dilution-block').classList.remove('hidden');
    $('reconstitution-block').classList.add('hidden');
    renderInjection(reg, form, mainRef, w, singleMg, dailyMg, capped, inconsistent);
  }

  if(refs.length > 1){
    renderComboComponents(refs.slice(1), reg, w);
  }

  $('res-note').textContent = activeDrug.indication_note || (activeLine && activeLine.line_label) || '';
  renderDrugMeta(mainRef, reg);
}
function getStandardBottleMl(drugKey, form){
  const conc = (form.concentration || '').toLowerCase();
  if(drugKey === 'amoxiclav'){
    if(conc.includes('400')) return 70;
    if(conc.includes('600')) return 100;
    if(conc.includes('250')) return 100;
    if(conc.includes('125')) return 100;
    return 70;
  }
  if(drugKey === 'amoxicillin') return 100;
  if(drugKey === 'cefixime') return 60;
  if(drugKey === 'azithromycin'){
    if(conc.includes('200')) return 30;
    return 20;
  }
  if(drugKey === 'clarithromycin') return 60;
  if(drugKey === 'cefuroxime') return 50;
  return 100;
}

function calculateCoursePackages(reg, form, singleMg, dailyMg, w){
  if(!singleMg || singleMg <= 0) return null;
  let days = 7;
  if(reg.duration_days){
    const m = String(reg.duration_days).match(/(\d+)(?:-(\d+))?/);
    if(m){
      days = m[2] ? parseInt(m[2]) : parseInt(m[1]);
    }
  }
  const isSolid = ['tablet', 'capsule'].includes(form.form_type);
  const concMgPerMl = form.concentration_mg_per_ml || 0;

  if(concMgPerMl > 0 && (!isSolid && (w < 40 || !form.form_type.includes('tablet')))){
    const singleMl = singleMg / concMgPerMl;
    const dailyMl = singleMl * reg.freq_per_day;
    const totalMl = dailyMl * days;
    const drugKey = getDrugRefs(activeDrug)[0];
    const bottleSize = getStandardBottleMl(drugKey, form);
    const count = Math.ceil(totalMl / bottleSize);
    const remainder = (count * bottleSize - totalMl).toFixed(1);
    return {
      type: 'suspension',
      days: days,
      singleMl: singleMl,
      dailyMl: dailyMl,
      totalMl: totalMl,
      bottleSize: bottleSize,
      bottleCount: count,
      remainderMl: remainder,
      summary: `Курс (${days} дн.): суммарно ${totalMl.toFixed(1)} мл → <b>${count} фл. по ${bottleSize} мл</b> (остаток: ${remainder} мл)`
    };
  } else if(isSolid){
    const strengthMatch = (form.concentration || '').match(/(\d+)\s*мг/);
    const strength = strengthMatch ? parseInt(strengthMatch[1]) : null;
    if(strength && strength > 0){
      const tabsPerDose = singleMg / strength;
      const totalTabs = Math.ceil(tabsPerDose * reg.freq_per_day * days);
      const packSize = totalTabs > 14 ? 20 : (totalTabs > 10 ? 14 : 10);
      const packs = Math.ceil(totalTabs / packSize);
      return {
        type: 'tablet',
        days: days,
        tabsPerDose: tabsPerDose,
        totalTabs: totalTabs,
        packSize: packSize,
        packCount: packs,
        summary: `Курс (${days} дн.): суммарно ${totalTabs} таб. → <b>${packs} уп. по ${packSize} таб.</b>`
      };
    }
  }
  return null;
}

function renderPO(reg, form, ref, w, singleMg, dailyMg, capped, inconsistent){
  const unit = doseUnitOf(ref);
  const concMgPerMl = form.concentration_mg_per_ml || 0;
  const isSolid = ['tablet','capsule'].includes(form.form_type);
  const isTopical = form.form_type === 'topical' || (typeof currentRouteGroup !== 'undefined' && currentRouteGroup === 'topical');

  if(isTopical || (singleMg === 0 && dailyMg === 0)){
    $('po-ml').textContent = '—';
    $('po-unit').textContent = '';
    $('po-tabs').textContent = '';
    const solidInstr = $('po-instruction');
    solidInstr.textContent = '';
    const solidIcon = document.createElement('i');
    solidIcon.className = isTopical ? 'fas fa-hand-holding-medical mr-2 text-blue-300' : 'fas fa-info-circle mr-2 text-blue-300';
    const solidLead = document.createElement('span');
    solidLead.textContent = isTopical ? 'Применять местно: ' : 'Схема назначения: ';
    const solidText = document.createElement('b');
    solidText.textContent = reg.duration_note || reg.regimen_label || (activeDrug && activeDrug.indication_note) || (form.notes ? form.notes + ' (' + form.concentration + ')' : form.concentration);
    const solidTail = document.createElement('span');
    solidTail.textContent = reg.freq_per_day ? ' • ' + reg.freq_per_day + ' р/д' : '';
    solidInstr.append(solidIcon, solidLead, solidText, solidTail);
    $('po-mg').textContent = '—';
    $('po-day').textContent = '—';
    $('po-dur').textContent = reg.duration_days || '—';
    const pkgEl = $('po-package-box');
    if(pkgEl) pkgEl.classList.add('hidden');
    $('po-range').classList.add('hidden');
    $('po-max-warn').classList.add('hidden');
    return;
  }

  if(isSolid || (w >= 40 && concMgPerMl === 0)){
    $('po-ml').textContent = unit === 'ЕД' ? formatUnits(Math.round(singleMg)) : Math.round(singleMg);
    $('po-unit').textContent = unit;
    $('po-tabs').textContent = unit === 'ЕД' ? '' : formatTablets(singleMg, form);
    // Кратность и концентрация формы приходят из БД — инструкция собирается
    // узлами, чтобы значение из БД не стало разметкой.
    const solidInstr = $('po-instruction');
    solidInstr.textContent = '';
    const solidIcon = document.createElement('i');
    solidIcon.className = 'fas fa-pills mr-2 text-blue-300';
    const solidLead = document.createElement('span');
    solidLead.textContent = 'Принимать по ';
    const solidDose = document.createElement('b');
    solidDose.textContent = fmtDose(singleMg, unit);
    const solidTail = document.createElement('span');
    solidTail.textContent = ' '+reg.freq_per_day+' р/д '+(form.concentration||'');
    solidInstr.append(solidIcon, solidLead, solidDose, solidTail);
  } else if(concMgPerMl > 0) {
    const ml = singleMg / concMgPerMl;
    $('po-ml').textContent = ml.toFixed(1);
    $('po-unit').textContent = 'мл';
    $('po-tabs').textContent = '';
    const instr = $('po-instruction');
    instr.textContent = '';
    const icon = document.createElement('i');
    icon.className = 'fas fa-flask mr-2 text-blue-300';
    const lead = document.createElement('span');
    lead.textContent = 'Давать по ';
    const dose = document.createElement('b');
    dose.textContent = ml.toFixed(1)+' мл';
    const tail = document.createElement('span');
    tail.textContent = ' суспензии ('+form.concentration+') '+reg.freq_per_day+' р/д';
    instr.append(icon, lead, dose, tail);
    if(ml > 15 && w < 40){
      const volWarn = document.createElement('div');
      volWarn.className = 'mt-2 text-[11px] font-bold text-amber-200 bg-amber-950/40 border border-amber-500/40 rounded-lg px-2.5 py-1.5';
      const volIcon = document.createElement('i');
      volIcon.className = 'fas fa-exclamation-triangle mr-1.5';
      volWarn.append(volIcon);
      volWarn.appendChild(document.createTextNode('Разовый объём велик ('+ml.toFixed(1)+' мл). Рекомендуется выбрать более концентрированную суспензию (напр., 400 или 600 мг/5 мл) или диспергируемые таблетки.'));
      instr.appendChild(volWarn);
    }
  } else {
    // Fail-closed: концентрация неизвестна — объём НЕ выдумываем (был 0.0 мл).
    $('po-ml').textContent = '—';
    $('po-unit').textContent = 'мл';
    $('po-tabs').textContent = '';
    const instr = $('po-instruction');
    instr.textContent = '';
    const icon = document.createElement('i');
    icon.className = 'fas fa-exclamation-triangle mr-2 text-amber-300';
    const lead = document.createElement('span');
    lead.textContent = 'Объём не рассчитан: нет данных о концентрации формы «'+(form.concentration||form.form_type)+'». Дозируйте по массе: ';
    const dose = document.createElement('b');
    dose.textContent = fmtDose(singleMg, unit);
    const tail = document.createElement('span');
    tail.textContent = ' '+reg.freq_per_day+' р/д';
    instr.append(icon, lead, dose, tail);
  }
  $('po-mg').textContent = fmtDose(singleMg, unit);
  $('po-day').textContent = fmtDose(dailyMg, unit);
  $('po-dur').textContent = reg.duration_days || '—';

  // Курсовой расчёт упаковок / флаконов
  const coursePkg = calculateCoursePackages(reg, form, singleMg, dailyMg, w);
  const pkgEl = $('po-package-box');
  if(pkgEl){
    if(coursePkg){
      pkgEl.classList.remove('hidden');
      // Сводка курса рендерится из числовых полей coursePkg, а не из строки
      // summary: строка содержит готовую разметку и не должна попадать в DOM
      // как HTML.
      const pkgText = $('po-package-text');
      pkgText.textContent = '';
      const pkgIcon = document.createElement('i');
      pkgIcon.className = 'fas fa-box-open mr-1.5 text-blue-200';
      const pkgLead = document.createElement('span');
      const pkgStrong = document.createElement('b');
      if(coursePkg.type === 'suspension'){
        pkgLead.textContent = 'Курс ('+coursePkg.days+' дн.): суммарно '+coursePkg.totalMl.toFixed(1)+' мл → ';
        pkgStrong.textContent = coursePkg.bottleCount+' фл. по '+coursePkg.bottleSize+' мл';
        const pkgTail = document.createElement('span');
        pkgTail.textContent = ' (остаток: '+coursePkg.remainderMl+' мл)';
        pkgText.append(pkgIcon, pkgLead, pkgStrong, pkgTail);
      } else {
        pkgLead.textContent = 'Курс ('+coursePkg.days+' дн.): суммарно '+coursePkg.totalTabs+' таб. → ';
        pkgStrong.textContent = coursePkg.packCount+' уп. по '+coursePkg.packSize+' таб.';
        pkgText.append(pkgIcon, pkgLead, pkgStrong);
      }
    } else {
      pkgEl.classList.add('hidden');
    }
  }

  const rangeEl = $('po-range');
  const uk = unit + '/кг/сут';
  if(reg.dose_range_mg_kg_day && reg.dose_range_mg_kg_day.length === 2){
    rangeEl.classList.remove('hidden');
    rangeEl.textContent = 'Диапазон по КР: '+reg.dose_range_mg_kg_day[0]+'-'+reg.dose_range_mg_kg_day[1]+' '+uk;
  } else if(reg.dose_mg_kg_day){
    rangeEl.classList.remove('hidden');
    rangeEl.textContent = 'Доза по КР: '+reg.dose_mg_kg_day+' '+uk;
  } else rangeEl.classList.add('hidden');

  const warnEl = $('po-max-warn');
  if(inconsistent){
    warnEl.querySelector('span').textContent = 'Данные БД несогласованы: разовая × кратность ≠ суточной. Расчёт выполнен по разовой дозе из КР — требуется проверка.';
    warnEl.classList.remove('hidden');
  } else if(capped){
    warnEl.querySelector('span').textContent = 'Превышена max суточная доза '+fmtDose(reg.max_daily_mg, unit)+'/сут — суточная и разовая дозы снижены до потолка ('+fmtDose(singleMg, unit)+' × '+reg.freq_per_day+' р/д). Проверьте режим по КР.';
    warnEl.classList.remove('hidden');
  } else warnEl.classList.add('hidden');
}
function formatTablets(mg, form){
  if(!['tablet','capsule'].includes(form.form_type)) return '';
  if(!mg || mg <= 0) return '';
  const m = form.concentration.match(/(\d+)\s*мг/);
  if(!m) return '';
  const strength = parseInt(m[1]);
  if(strength <= 0) return '';
  const tabs = mg / strength;
  if(tabs === Math.round(tabs)) return '('+tabs+' таб '+strength+' мг)';
  const half = Math.round(tabs*2)/2;
  return '(~'+half+' таб '+strength+' мг)';
}
function renderReconstitution(form){
  const block = $('reconstitution-block');
