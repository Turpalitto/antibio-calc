  const refs = getDrugRefs(activeDrug);
  const ref = DB.drugs_reference[refs[0]];
  const unit = doseUnitOf(ref);
  const {singleMg, dailyMg} = computeDose(reg, w, unit);
  const form = ref.forms[activeFormIdx];
  const days = reg.duration_days || '7-10';
  const coursePkg = calculateCoursePackages(reg, form, singleMg, dailyMg, w);

  let doseStr = '';
  if(singleMg <= 0 && dailyMg <= 0){
    doseStr = (reg.duration_note || reg.regimen_label || 'По схеме клинических рекомендаций') + (reg.freq_per_day ? ' ' + reg.freq_per_day + ' р/сут' : '');
  } else if(currentRouteGroup === 'topical' || form.form_type === 'topical'){
    doseStr = 'наружно/местно ' + (form.notes ? form.notes + ' ' : '') + form.concentration + (reg.freq_per_day ? ' ' + reg.freq_per_day + ' р/сут' : '');
  } else if(currentRouteGroup === 'po' && form.concentration_mg_per_ml && w < 40){
    const ml = (singleMg / form.concentration_mg_per_ml).toFixed(1);
    doseStr = 'по '+ml+' мл ('+fmtDose(singleMg, unit)+') внутрь '+reg.freq_per_day+' р/сут';
  } else if(['tablet','capsule'].includes(form.form_type)){
    doseStr = 'по '+fmtDose(singleMg, unit)+' '+formatTablets(singleMg, form)+' внутрь '+reg.freq_per_day+' р/сут';
  } else {
    doseStr = 'по '+fmtDose(singleMg, unit)+' '+(currentRouteGroup === 'im' ? 'в/м' : 'в/в')+' '+reg.freq_per_day+' р/сут';
  }

  let txt = 'НАЗНАЧЕНИЕ АНТИБАКТЕРИАЛЬНОЙ ТЕРАПИИ (для карты / МИС):\n';
  txt += 'Пациент: вес '+w+' кг ('+(activeAge === 'child' ? 'дети' : (activeAge === 'neonate' ? 'новорожденный' : 'взрослый'))+')\n';
  txt += 'Диагноз: '+activeDisease.name+' (МКБ-10: '+activeDisease.mkb10.join(', ')+')\n';
  txt += 'Обоснование: КР МЗ РФ #'+(activeDisease.cr_id || '—')+' ('+(activeDisease.cr_year || '2024')+')\n';
  txt += '----------------------------------------\n';
  txt += 'Препарат: '+ref.inn+'\n';
  txt += 'Форма: '+(form.concentration || form.form_type)+'\n';
  txt += 'Режим: '+(reg.regimen_label || (reg.dose_mg_kg_day ? reg.dose_mg_kg_day + ' мг/кг/сут' : (reg.duration_note || 'По схеме КР')))+'\n';
  txt += 'Схема приёма: '+doseStr+'\n';
  txt += 'Курс лечения: '+days+' дней\n';
  if(coursePkg){
    txt += 'Потребность на курс: '+coursePkg.summary.replace(/<\/?[^>]+(>|$)/g, '')+'\n';
  }
  if(reg.duration_note){
    txt += 'Указания: '+reg.duration_note+'\n';
  }

  navigator.clipboard.writeText(txt).then(()=>{
    toast('✅ Назначение скопировано для МИС');
  }).catch(()=>toast('Ошибка копирования'));
}

