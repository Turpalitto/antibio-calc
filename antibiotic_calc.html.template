function buildPersonalRequest(){
  if(!$('personal-mode-toggle').checked) throw new Error('Личный режим не включён');
  if(!isLoopbackOrigin()) throw new Error('Режим разрешён только на loopback origin');
  if(!activeDisease) throw new Error('Сначала выберите нозологию во встроенном калькуляторе');
  const ownerId = $('personal-owner-id').value.trim();
  const sessionToken = $('personal-session-token').value.trim();
  const pregnancy = $('personal-pregnancy').value;
  const hepatic = $('personal-hepatic').value;
  const renal = $('personal-renal').value.trim();
  const allergiesRaw = $('personal-allergies').value.trim();
  const medsRaw = $('personal-current-meds').value.trim();
  const contraindicationsCleared = $('personal-contra-cleared').value === 'yes';
  const interactionsReviewed = $('personal-interactions-reviewed').value === 'yes';
  if(!ownerId || !sessionToken) throw new Error('Требуются локальные owner_id и session_token');
  if(pregnancy === 'unknown' || hepatic === 'unknown' || !renal || !allergiesRaw || !medsRaw || !contraindicationsCleared || !interactionsReviewed) throw new Error('Заполните и подтвердите все safety-поля; неизвестные значения блокируют запрос');
  const age = parseFloat($('patient-age').value);
  const weight = parseFloat($('weight').value);
  return {
    api_version:'2', operating_mode:'PERSONAL_PHYSICIAN', owner_id:ownerId, session_token:sessionToken,
    query:{
      diagnosis:activeDisease.name,
      icd10:(activeDisease.mkb10||[])[0] || null,
      patient:{
        age:Number.isFinite(age)&&age>=0?age:null,
        weight_kg:Number.isFinite(weight)&&weight>0?weight:null,
        pregnant:pregnancy === 'yes', renal_function:renal,
        hepatic_impairment:hepatic === 'yes',
        allergies:splitLocalList(allergiesRaw), current_meds:splitLocalList(medsRaw),
        contraindications_cleared:contraindicationsCleared, interactions_reviewed:interactionsReviewed
      },
      preferences:{population:activeAge}
    }
  };
}
function validatePersonalEnvelope(body){
  if(!body || body.api_version !== '2' || body.operating_mode !== 'PERSONAL_PHYSICIAN') throw new Error('Несовместимый ответ API v2');
  if(body.status !== 'OWNER_REVIEWED') throw new Error((body.review&&(body.review.reason||body.review.detail)) || ('API: '+(body.status||'ERROR')));
  if(body.governance_status !== 'OWNER_REVIEWED_EXPERIMENTAL') throw new Error('Неверный governance_status ответа');
  if(!body.banner || body.banner.dismissible !== false) throw new Error('Ответ не содержит обязательный non-dismissible banner');
  if(!Array.isArray(body.recommendations) || body.recommendations.length === 0) throw new Error('API не вернул допустимых кандидатов');
  body.recommendations.forEach((candidate, index)=>{
    if(candidate.governance_status !== 'OWNER_REVIEWED_EXPERIMENTAL') throw new Error('Кандидат '+(index+1)+': неверный governance_status');
    resolveCalculatorBinding(candidate.calculator_binding);
    if(candidate.calculator_binding_verified !== true) throw new Error('Кандидат не прошёл проверку hash-привязки калькулятора');
  });
  return body.recommendations;
}
