// Хранилище истории. PHI (Ф.И.О., диагноз, дозы) НЕ пишется в localStorage:
// по умолчанию записи живут только в памяти вкладки, а явное согласие врача
// (#history-persist) включает sessionStorage — хранилище той же вкладки,
// которое умирает вместе с ней и недоступно другим вкладкам/сессиям.
const HISTORY_KEY = 'antibio_history';
const HISTORY_MAX = 20;
function historySessionAvailable(){
  try{ return typeof sessionStorage !== 'undefined' && !!sessionStorage; }catch(_){ return false; }
}
function historyPersistAllowed(){
  const box = $('history-persist');
  return !!(box && box.checked && historySessionAvailable());
}
function purgeLegacyHistory(){
  try{ if(localStorage.getItem(HISTORY_KEY) !== null) localStorage.removeItem(HISTORY_KEY); }catch(_){}
}
function initHistoryStore(){
  purgeLegacyHistory();
  const note = $('history-storage-note');
  const warn = $('history-persist-warn');
  if(!historySessionAvailable()){
    if(note) note.textContent = 'Хранилище вкладки недоступно: история хранится только в памяти и исчезает при перезагрузке или закрытии вкладки. Данные пациента на диск не попадают.';
    const box = $('history-persist');
    if(box){ box.checked = false; box.disabled = true; }
    if(warn) warn.textContent = 'Хранилище вкладки недоступно.';
    return;
  }
  if(note) note.textContent = 'История хранится только в памяти вкладки и исчезает при закрытии. Данные пациента на диск не попадают, пока вы не разрешите хранение во вкладке.';
}
function onHistoryPersistChange(){
  const allowed = historyPersistAllowed();
  const hist = readHistoryEntries();
  if(allowed){
    writeSessionHistory(hist);
    toast('История сохраняется в этой вкладке до её закрытия');
  } else {
    try{ sessionStorage.removeItem(HISTORY_KEY); }catch(_){}
    historyEntries = hist.slice(0, HISTORY_MAX);
    toast('Хранение вкладки отключено; история только в памяти');
  }
  loadHistory();
}
function readHistoryEntries(){
  // S-3 PHI TTL: a stored patient history entry expires 24h after it was
  // written. Filtering happens on read (storage AND memory) so expired
  // Ф.И.О./diagnosis data stops being rendered or re-persisted. All logic
  // is inline: the safety tests extract this function as-is.
  const cutoff = Date.now() - 86400000;
  const fresh = arr => arr.filter(e => e && typeof e.ts === 'number' && e.ts >= cutoff);
  if(historySessionAvailable()){
    try{
      const raw = sessionStorage.getItem(HISTORY_KEY);
      if(raw){
        const parsed = JSON.parse(raw);
        if(Array.isArray(parsed)) return fresh(parsed);
      }
    }catch(_){}
  }
  return fresh(historyEntries.slice());
}
function writeSessionHistory(list){
  historyEntries = list.slice(0, HISTORY_MAX);
  if(!historyPersistAllowed()) return historyEntries;
  try{ sessionStorage.setItem(HISTORY_KEY, JSON.stringify(historyEntries)); }catch(_){}
  return historyEntries;
}
function saveToHistory(){
  if(!activeDrug || !activeDisease){ toast('Нет активного расчёта'); return; }
  const w = parseFloat($('weight').value);
  const reg = requireActiveRegimen('Сохранение в историю');
  if(!reg) return;
  const ref = DB.drugs_reference[getDrugRefs(activeDrug)[0]];
  const unit = doseUnitOf(ref);
  const {singleMg, dailyMg} = computeDose(reg, w, unit);
  const entry = {
    ts: Date.now(),
    patient: $('patient-name').value || '',
    disease: activeDisease.name,
    drug: ref.inn,
    unit: unit,
    singleMg: Math.round(singleMg),
    dailyMg: Math.round(dailyMg),
    freq: reg.freq_per_day,
    duration: reg.duration_days || '—',
    durationNote: reg.duration_note || reg.regimen_label || '',
    weight: w,
    ageGroup: activeAge
  };
  const hist = readHistoryEntries();
  hist.unshift(entry);
  writeSessionHistory(hist);
  toast(historyPersistAllowed() ? 'Сохранено в историю (вкладка)' : 'Сохранено в историю (только до закрытия вкладки)');
}
function loadHistory(){
  const hist = readHistoryEntries();
  const list = $('history-list');
  list.innerHTML = '';
  if(hist.length === 0){
    const empty = document.createElement('p');
    empty.className = 'text-xs text-slate-400 text-center py-8';
    empty.textContent = 'История пуста';
    list.appendChild(empty);
    return;
  }
  hist.forEach((e, idx)=>{
    const div = document.createElement('div');
    div.className = 'premium-card p-3 text-xs cursor-pointer hover:bg-blue-50 dark:hover:bg-slate-700';
    const dt = new Date(e.ts);
    // e.patient — необработанный ввод пользователя: только textContent, иначе
    // сохранённое Ф.И.О. исполняется как HTML при открытии истории.
    const top = document.createElement('div');
    top.className = 'flex justify-between';
    const drug = document.createElement('span');
    drug.className = 'font-bold text-slate-700 dark:text-slate-200';
    drug.textContent = e.drug || '';
    const when = document.createElement('span');
    when.className = 'text-slate-400';
    when.textContent = dt.toLocaleDateString('ru-RU')+' '+dt.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});
    top.append(drug, when);
    const disease = document.createElement('div');
    disease.className = 'text-slate-500 dark:text-slate-400 mt-1';
    disease.textContent = e.disease || '';
    const dose = document.createElement('div');
    dose.className = 'text-slate-600 dark:text-slate-300 mt-1 font-bold';
    let formattedDose = '';
    const u = e.unit || 'мг';
    if(typeof fmtDose === 'function'){
      formattedDose = fmtDose(e.singleMg, u);
    } else {
      if(u === 'ЕД'){
        formattedDose = e.singleMg >= 1e6 ? (e.singleMg/1e6).toFixed(1).replace(/\.0$/, '') + ' млн ЕД' : (e.singleMg >= 1e3 ? Math.round(e.singleMg/1e3) + ' тыс. ЕД' : e.singleMg + ' ЕД');
      } else {
        formattedDose = e.singleMg + ' ' + u;
      }
    }
    const doseStr = e.singleMg <= 0 ? (e.durationNote || 'По схеме КР') : (formattedDose + (e.freq ? ' × ' + e.freq + ' р/д' : ''));
    dose.textContent = doseStr + (e.duration && e.duration !== '—' ? ', курс ' + e.duration : '') + (e.patient ? ' • ' + e.patient : '');
    div.append(top, disease, dose);
    list.appendChild(div);
  });
}
function openHistory(){
  loadHistory();
  $('history-drawer').classList.add('open');
  $('drawer-overlay').classList.add('open');
}
function closeHistory(){
  $('history-drawer').classList.remove('open');
  $('drawer-overlay').classList.remove('open');
}
function clearHistory(){
  if(confirm('Очистить всю историю?')){
    historyEntries = [];
    if(historySessionAvailable()){ try{ sessionStorage.removeItem(HISTORY_KEY); }catch(_){} }
    loadHistory();
    toast('История очищена');
  }
}
function updateHash(){
  if(!activeDisease || !activeDrug) return;
  const h = [activeDisease.id, activeScenario?activeScenario.id:'', activeLine?'L'+activeLine.line_number:''].join('/');
  history.replaceState(null, '', '#'+h);
}
function restoreFromHash(){
  const h = window.location.hash.slice(1);
  if(!h) return;
  const parts = h.split('/');
  const disease = DB.recommendations.find(d=>d.id === parts[0]);
  if(!disease) return;
  selectDisease(disease);
}
init();
</script>

