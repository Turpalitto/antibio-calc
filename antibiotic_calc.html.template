<script id="db-data" type="application/json">__DB_PLACEHOLDER__</script>
<script>
let DB = null;
let activeDisease = null, activeScenario = null, activeLine = null, activeDrug = null, activeFormIdx = 0, activeRegimenIdx = 0, activeRouteKey = null, activeVialIdx = 0;
let activeAge = 'child';
let userPickedAge = false;
let currentRouteGroup = 'all';
let personalCandidates = [];
let extractedReviewCandidates = [];

function $(id){return document.getElementById(id);}
function toast(msg){
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(()=>t.classList.remove('show'), 2500);
}
function validateDB(){
  const errs = [], warns = [];
  if(!DB || !DB.recommendations || !DB.drugs_reference){ errs.push('Нет БД'); return {errs,warns}; }
  const drugKeys = Object.keys(DB.drugs_reference).filter(k=>k!=='_note');
  const ICD10 = /^[A-Z]\d{2}(\.\d{1,3})?$/;
  const LINK_METHODS = ['ICD10_EXACT','ICD10_BLOCK','TITLE_EXACT'];
  const seenIds = new Set();
  DB.recommendations.forEach((r,i)=>{
    if(!r.id) errs.push('rec['+i+']: нет id');
    else if(seenIds.has(r.id)) errs.push('rec['+i+'] '+r.id+': дубль id нозологии');
    else seenIds.add(r.id);
    if(!r.mkb10||!r.mkb10.length) errs.push('rec['+i+'] '+r.id+': нет mkb10');
    // Каждый элемент mkb10 обязан быть ОДНИМ кодом: склейка "C83.5, C91.0"
    // ломает поиск по МКБ и связь с корпусом КР.
    (r.mkb10||[]).forEach(c=>{ if(typeof c!=='string'||!ICD10.test(c.trim())) errs.push('rec['+i+'] '+r.id+': некорректный код МКБ-10 "'+c+'"'); });
    if(!r.name) errs.push('rec['+i+']: нет name');
    if(!r.cr_id) warns.push('rec['+i+'] '+r.id+': нет cr_id');
    if(!r.cr_year) warns.push('rec['+i+'] '+r.id+': нет cr_year');
    if(r.guideline_links!==undefined){
      if(!Array.isArray(r.guideline_links)) errs.push('rec['+i+'] '+r.id+': guideline_links должен быть массивом');
      else r.guideline_links.forEach((l,li)=>{
        if(!l.guideline_id||!l.title) errs.push('rec['+i+'] '+r.id+'>link['+li+']: нет guideline_id/title');
        if(LINK_METHODS.indexOf(l.method)===-1) errs.push('rec['+i+'] '+r.id+'>link['+li+']: неизвестный метод "'+l.method+'"');
      });
    }
    (r.scenarios||[]).forEach((s,si)=>{
      if(!s.id) errs.push('rec['+i+'] '+r.id+'>scenario['+si+']: нет id');
      if(!s.name) errs.push('rec['+i+'] '+r.id+'>scenario['+si+']: нет name');
      (s.lines||[]).forEach((l,li)=>{
        if(l.line_number==null) errs.push('rec['+i+'] '+r.id+'>scenario['+si+']>line['+li+']: нет line_number');
        (l.drugs||[]).forEach((d,di)=>{
          if(d.drug_ref&&!drugKeys.includes(d.drug_ref)) errs.push('drug_ref "'+d.drug_ref+'" не найден в drugs_reference');
          if(d.combo_ref) d.combo_ref.forEach((cr,cdi)=>{ if(!drugKeys.includes(cr)) errs.push('combo_ref "'+cr+'" не найден'); });
          if(!d.route||!d.route.length) warns.push('rec['+i+'] '+r.id+'>drug '+d.drug_ref+': нет route');
          (d.regimens||[]).forEach((rg,ri)=>{
            if(!rg.freq_per_day) errs.push('rec['+i+'] '+r.id+'>drug '+d.drug_ref+' regimen['+ri+']: нет freq_per_day');
            if(!rg.duration_days) warns.push('rec['+i+'] '+r.id+'>drug '+d.drug_ref+' regimen['+ri+']: нет duration_days');
          });
        });
      });
    });
  });
  return {errs,warns};
}
function init(){
  try{
    const raw = $('db-data').textContent.trim();
    DB = JSON.parse(raw);
    document.getElementById('verification-status').textContent = (DB.meta.verification_status||'draft').toUpperCase()+' • '+DB.meta.warning;
    document.getElementById('header-stats').textContent = 'КР МЗ РФ • '+DB.recommendations.length+' нозологий • '+Object.keys(DB.drugs_reference).filter(k=>k!=='_note').length+' препаратов';
    document.getElementById('empty-state-stats').textContent = DB.recommendations.length+' нозологий • '+Object.keys(DB.drugs_reference).filter(k=>k!=='_note').length+' препаратов • КР МЗ РФ';
    const v = validateDB();
    const statusEl = document.getElementById('header-stats');
    if(v.errs.length){
      statusEl.textContent += ' • ❌ '+v.errs.length+' ош';
      statusEl.className = 'text-red-500 text-[10px] font-bold mt-0.5 uppercase tracking-widest italic';
    } else if(v.warns.length){
      statusEl.textContent += ' • ⚠️ '+v.warns.length+' пред';
      statusEl.className = 'text-amber-500 text-[10px] font-bold mt-0.5 uppercase tracking-widest italic';
    } else {
      statusEl.textContent += ' • ✓ БД';
    }
  }catch(e){
    $('empty-state').innerHTML = '<p class="text-red-600 font-bold">Ошибка загрузки БД: '+e.message+'</p>';
    return;
  }
  document.querySelectorAll('#age-group button').forEach(b=>{
    b.onclick = ()=>{
      document.querySelectorAll('#age-group button').forEach(x=>x.classList.remove('active'));
      b.classList.add('active');
      activeAge = b.dataset.age;
      userPickedAge = true;
      if(activeDisease) renderScenarios();
      calculate();
    };
  });
  setupButtons();
  setupPersonalMode();
  setupTheme();
  loadHistory();
  if(window.location.hash){
    setTimeout(restoreFromHash, 100);
  }
}
function setupButtons(){
  $('btn-print').onclick = ()=>{ if(!activeDrug){toast('Выберите препарат');return;} fillPrescriptionForm(); window.print(); };
  $('btn-print2').onclick = ()=>{ if(!activeDrug){toast('Выберите препарат');return;} fillPrescriptionForm(); window.print(); };
  $('btn-copy').onclick = copyPrescription;
  $('btn-save-history').onclick = saveToHistory;
  $('btn-history').onclick = openHistory;
  $('btn-theme').onclick = toggleTheme;
  $('drawer-close').onclick = closeHistory;
  $('drawer-overlay').onclick = closeHistory;
  $('history-clear').onclick = clearHistory;
  document.querySelector('.mobile-nav').style.display = (window.innerWidth < 768) ? 'flex' : 'none';
  window.addEventListener('resize', ()=>{
    document.querySelector('.mobile-nav').style.display = (window.innerWidth < 768) ? 'flex' : 'none';
  });
}
function isLoopbackOrigin(){
  return window.location.hostname === '127.0.0.1' || window.location.hostname === 'localhost';
}
function setPersonalStatus(state, message){
  const el = $('personal-api-status');
  el.dataset.state = state;
  el.textContent = message;
}
function setupPersonalMode(){
