    line.drugs.forEach((drug, drugIdx)=>{
      const isCombo = !!drug.combo_ref;
      const refs = isCombo ? drug.combo_ref : [drug.drug_ref];
      const names = refs.map(r=>(DB.drugs_reference[r]&&DB.drugs_reference[r].inn)||r).join(' + ');
      const lineCls = line.line_number === 1 ? 'line-1' : (line.line_number === 2 ? 'line-2' : 'line-0');
      const lineLabel = line.line_number === 1 ? 'Линия 1' : (line.line_number === 2 ? 'Линия 2' : 'Альт.');

      let allergyStatus = { status: 'safe', label: '', alert: null };
      refs.forEach(r => {
        const res = checkAllergyStatus(r, currentAllergy);
        if(res.status === 'contraindicated') allergyStatus = res;
        else if(res.status === 'caution' && allergyStatus.status !== 'contraindicated') allergyStatus = res;
        else if(res.status === 'recommended' && allergyStatus.status === 'safe') allergyStatus = res;
      });

      let allergyBadgeEl = null;
      let cardAllergyClass = '';
      if(allergyStatus.status === 'contraindicated'){
