  renderDilutionBlock(ref, activeRouteKey, singleMg, selectedVial, routeData);
}
function routeKeyLabel(k){
  return k === 'im' ? 'в/м' : (k === 'iv_bolus' ? 'в/в струйно' : 'в/в капельно');
}
// Единственный источник концентрации готового раствора. Тот же `||`-фолбэк раньше
// был продублирован в трёх местах (подсказка «на дозу», блок разведения и латинская
// форма рецепта) — ровно тот класс расхождений, что дал баги с единицами действия,
// базисом таблетки и делителем таблетки. Одно извлечение — одна точка правды.
function vialConcentrationPerMl(vial){
  if(!vial) return null;
  if(vial.final_concentration_mg_ml > 0) return {value: vial.final_concentration_mg_ml, unit: 'мг'};
  if(vial.final_concentration_units_ml > 0) return {value: vial.final_concentration_units_ml, unit: 'ЕД'};
  return null;
}
// Надписи на флаконе. `units` позволяет латинской форме печатать «mg»/«ED».
// formatUnits применяется ТОЛЬКО к единицам действия: для мг он превратил бы
// флакон 1000 мг в «1 тыс мг», а в БД есть vial_mg 1000/1500/2000/4000.
function vialStrengthLabel(vial, units){
  if(!vial) return '';
  if(vial.vial_mg) return vial.vial_mg+' '+(units ? 'mg' : 'мг');
  if(vial.vial_units) return formatUnits(vial.vial_units)+' '+(units ? 'ED' : 'ЕД');
  return '';
}
function vialConcentrationLabel(vial, units){
  const conc = vialConcentrationPerMl(vial);
  if(!conc) return '';
  if(conc.unit === 'ЕД') return formatUnits(conc.value)+' '+(units ? 'ED/ml' : 'ЕД/мл');
  return conc.value+' '+(units ? 'mg/ml' : 'мг/мл');
}
function injectableMlForDose(singleMg, vial, units){
  const conc = vialConcentrationPerMl(vial);
  if(!conc || !(singleMg > 0)) return units ? '—' : '';
  return (singleMg / conc.value).toFixed(2)+' '+(units ? 'ml' : 'мл');
}
function computeInjectableMl(singleMg, vial){
  return injectableMlForDose(singleMg, vial, false) || '—';
}
function renderDilutionBlock(ref, routeKey, singleMg, selectedVial, routeData){
