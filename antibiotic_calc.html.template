  const cr = hasCr ? 'КР №'+activeDisease.cr_id+' • '+activeDisease.cr_year : (activeDisease ? 'Схема антимикробной терапии' : '');
  const url = activeDisease ? activeDisease.source_url : '';
  const crNote = (activeDisease && !hasCr && activeDisease.cr_note) ? activeDisease.cr_note : '';
  // Все значения — из БД, поэтому метаданные строятся узлами: строка разметки
