function checkAllergyStatus(drugKey, allergy){
  if(!allergy || allergy === 'none') return { status: 'safe', label: '', alert: null };
  const cls = DRUG_CLASSES[drugKey] || '';
  if(allergy === 'penicillin_severe'){
    if(cls.startsWith('penicillin') || cls.startsWith('cephalosporin') || cls === 'carbapenem'){
      return {
        status: 'contraindicated',
        label: '⛔ Противопоказано',
        alert: 'Тяжёлая аллергия (анафилаксия, ангионевротический отёк) на пенициллины — абсолютное противопоказание ко ВСЕМ бета-лактамам (пенициллины, цефалоспорины, карбапенемы). Рекомендованы макролиды (кларитромицин, азитромицин) или респираторные фторхинолоны.'
      };
    }
    return { status: 'recommended', label: '✅ Безопасно', alert: null };
  }
  if(allergy === 'penicillin_mild'){
    if(cls.startsWith('penicillin')){
      return {
        status: 'contraindicated',
        label: '⛔ Противопоказано',
        alert: 'Пенициллины противопоказаны. При нетяжёлой реакции в анамнезе (сыпь без анафилаксии) допустимо применение цефалоспоринов III–IV поколения под врачебным контролем.'
      };
    }
    if(cls === 'cephalosporin_1'){
      return {
        status: 'caution',
        label: '⚠️ Высокий перекрёст',
        alert: 'Цефалоспорины I поколения имеют сходные боковые цепи с аминопенициллинами. Риск перекрёстной реакции до 10%.'
      };
    }
    if(cls.startsWith('cephalosporin')){
      return {
        status: 'caution',
        label: '⚠️ С осторожностью',
        alert: 'Цефалоспорины III–IV поколения имеют минимальный риск перекрёста (<1%). Допустимы при лёгкой сыпи в анамнезе.'
      };
    }
    return { status: 'recommended', label: '✅ Безопасно', alert: null };
  }
  if(allergy === 'cephalosporin'){
    if(cls.startsWith('cephalosporin')){
      return {
        status: 'contraindicated',
        label: '⛔ Противопоказано',
        alert: 'Цефалоспорины противопоказаны. Рекомендуется альтернативная группа (макролиды, фторхинолоны, аминогликозиды).'
      };
    }
    return { status: 'safe', label: '', alert: null };
  }
  return { status: 'safe', label: '', alert: null };
}

function onAllergyChange(){
  const allergy = $('patient-allergy').value;
  const badge = $('allergy-badge');
  if(badge){
    badge.classList.toggle('hidden', allergy === 'none');
    badge.textContent = allergy === 'none' ? '' : 'активен';
  }
  if(activeScenario){
    renderLines();
  }
  updateAllergyBanner();
}

function updateAllergyBanner(){
  const banner = $('allergy-alert-banner');
  if(!banner || !activeDrug) return;
  const allergy = $('patient-allergy') ? $('patient-allergy').value : 'none';
  const refs = getDrugRefs(activeDrug);
  let worstStatus = { status: 'safe', label: '', alert: null };
  refs.forEach(r => {
    const res = checkAllergyStatus(r, allergy);
    if(res.status === 'contraindicated') worstStatus = res;
    else if(res.status === 'caution' && worstStatus.status !== 'contraindicated') worstStatus = res;
    else if(res.status === 'recommended' && worstStatus.status === 'safe') worstStatus = res;
  });

  if(worstStatus.status === 'contraindicated'){
    banner.classList.remove('hidden');
    $('allergy-alert-title').textContent = 'Внимание: Препарат противопоказан по аллергоанамнезу!';
    $('allergy-alert-text').textContent = worstStatus.alert || '';
    $('allergy-alert-recommend').textContent = 'Выберите альтернативную линию терапии (макролиды, фторхинолоны).';
  } else if(worstStatus.status === 'caution'){
    banner.classList.remove('hidden');
    $('allergy-alert-title').textContent = 'Предостережение: Требуется осторожность';
    $('allergy-alert-text').textContent = worstStatus.alert || '';
    $('allergy-alert-recommend').textContent = '';
  } else {
    banner.classList.add('hidden');
  }
}

