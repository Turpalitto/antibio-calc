function getDrugRefs(drug){
  if(drug.combo_ref) return drug.combo_ref;
  return [drug.drug_ref];
}
function renderForms(preferredRoute){
  const refs = getDrugRefs(activeDrug);
  const mainRef = DB.drugs_reference[refs[0]];
  if(!mainRef) return;
  const forms = mainRef.forms || [];
  const grid = $('form-grid');
  grid.innerHTML = '';
  const routeTabs = $('route-tabs');
  routeTabs.innerHTML = '';

  const availNote = $('availability-note');
  if(mainRef.availability_note){
    availNote.querySelector('span').textContent = mainRef.availability_note;
    availNote.classList.remove('hidden');
  } else {
    availNote.classList.add('hidden');
  }

  const groups = {po:[], im:[], iv:[], topical:[]};
  forms.forEach((f, idx)=>{
    if(f.form_type === 'topical'){
      groups.topical.push({f, idx});
      return;
    }
    // powder_for_suspension используется и для пероральной суспензии (есть concentration_mg_per_ml),
    // и для инъекционного флакона (готовится через dilution) — различаем по этому полю,
    // иначе пероральная детская суспензия попадает в группу "в/в".
    if(['tablet','capsule','suspension','syrup','granules'].includes(f.form_type)
       || (f.form_type === 'powder_for_suspension' && f.concentration_mg_per_ml != null)){
      groups.po.push({f, idx});
      return;
    }
    // Один и тот же инъекционный флакон часто годится и для в/м, и для в/в (просто разное разведение) —
    // проверяем оба пути НЕЗАВИСИМО (не else-if), иначе "в/в" никогда не заполнится, если есть "в/м".
    let matched = false;
    if(mainRef.dilution && mainRef.dilution.im && ['powder_for_suspension','powder_for_injection','solution_im'].includes(f.form_type)){
      groups.im.push({f, idx});
      matched = true;
    }
    if(mainRef.dilution && (mainRef.dilution.iv_bolus || mainRef.dilution.iv_infusion) && ['powder_for_suspension','powder_for_injection','solution_iv'].includes(f.form_type)){
      groups.iv.push({f, idx});
      matched = true;
    }
    if(!matched){
      if(f.form_type === 'solution_iv'){
        groups.iv.push({f, idx});
      } else if(f.form_type === 'solution_im'){
        groups.im.push({f, idx});
      } else if(f.form_type === 'powder_for_injection'){
        groups.iv.push({f, idx});
        groups.im.push({f, idx});
      } else {
        groups.po.push({f, idx});
      }
    }
  });

  const groupKeys = Object.keys(groups).filter(k=>groups[k].length>0);
  if(groupKeys.length === 0) return;

  // Показываем только пути введения, указанные в самом сценарии (activeDrug.route) —
  // иначе можно случайно предложить, например, пероральную форму для препарата,
  // который в этом сценарии клинически эффективен только в/в (напр. ванкомицин при сепсисе).
  const routeMap = {per_os:'po', iv:'iv', im:'im', topical:'topical'};
  const intendedKeys = (activeDrug.route || []).map(r=>routeMap[r]).filter(Boolean);
  const restrictedKeys = groupKeys.filter(k=>intendedKeys.includes(k));
  const finalKeys = restrictedKeys.length > 0 ? restrictedKeys : groupKeys;

  currentRouteGroup = preferredRoute && finalKeys.includes(preferredRoute) ? preferredRoute : finalKeys[0];
  finalKeys.forEach(k=>{
    const tab = document.createElement('button');
    tab.className = 'route-tab chip text-[10px] font-black uppercase rounded-lg px-2 py-1'+(k===currentRouteGroup?' active':'');
    const label = k==='po'?'per os':(k==='im'?'в/м':(k==='iv'?'в/в':'местно'));
    tab.textContent = label;
    tab.onclick = ()=>{
      currentRouteGroup = k;
      routeTabs.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
      tab.classList.add('active');
      renderFormChips(groups[k]);
      calculate();
    };
    routeTabs.appendChild(tab);
  });
  renderFormChips(groups[currentRouteGroup]);
}
function renderFormChips(group){
  const grid = $('form-grid');
  grid.innerHTML = '';
  if(group.length === 0){ grid.innerHTML = '<p class="text-xs text-slate-400">Нет форм для этого пути</p>'; return; }
  // Детям/новорождённым по умолчанию предпочитаем жидкую форму (суспензия/сироп) — не все могут проглотить таблетку
  let defaultIdx = 0;
  if(activeAge === 'child' || activeAge === 'neonate'){
    // Закрепляем жидкую форму ТОЛЬКО если у неё есть готовая концентрация (mg/ml),
    // иначе можно выбрать парентеральный флакон (powder_for_suspension без mg/ml),
    // который даст деление на 0 и Infinity (напр. цефуроксим '750 мг флакон').
    const liquidPos = group.findIndex(g=>['suspension','syrup','powder_for_suspension'].includes(g.f.form_type) && g.f.concentration_mg_per_ml != null);
    if(liquidPos !== -1) defaultIdx = liquidPos;
  }
  group.forEach((entry, i)=>{
    const f = entry.f;
    const idx = entry.idx;
    const btn = document.createElement('button');
    btn.className = 'chip rounded-xl py-2 md:py-3 px-2 text-[10px] font-black uppercase tracking-wider text-left'+(i===defaultIdx?' active':'');
    let routeIcon = 'fa-pill';
    if(f.form_type === 'tablet' || f.form_type === 'capsule') routeIcon = 'fa-pills';
    else if(['powder_for_suspension','suspension','syrup'].includes(f.form_type)) routeIcon = 'fa-flask';
    else if(f.form_type === 'solution_iv') routeIcon = 'fa-drip';
    else if(f.form_type === 'solution_im' || f.form_type === 'powder_for_injection') routeIcon = 'fa-syringe';
    else if(f.form_type === 'granules') routeIcon = 'fa-prescription-bottle';
    // Концентрация и примечание к форме приходят из БД — только textContent.
    const formIcon = document.createElement('i');
    formIcon.className = 'fas '+routeIcon+' mr-1';
    const conc = document.createElement('div');
    conc.textContent = f.concentration;
    btn.append(formIcon, conc);
    if(f.notes){
      const formNote = document.createElement('div');
      formNote.className = 'text-[8px] font-bold opacity-70 mt-0.5 normal-case';
      formNote.textContent = f.notes;
      btn.appendChild(formNote);
    }
    btn.onclick = ()=>{
      activeFormIdx = idx;
      grid.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      calculate();
    };
    grid.appendChild(btn);
  });
  activeFormIdx = group[defaultIdx].idx;
}
function renderRegimens(preferredRegimenIdx){
