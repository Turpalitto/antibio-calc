  solution_iv:'sol. pro inject.', solution_im:'sol. pro inject.',
  granules:'gran.', topical:'ung.', suppository:'supp.'
};
const LATIN_ROUTE = { po:'per os', im:'intramuscularis', iv:'intravenosus' };
const LATIN_FREQ = { 1:'semel in die', 2:'bis in die', 3:'ter in die', 4:'quater in die', 6:'sexies in die' };

// Кратность приёма в трёх стилях. Единственный источник: раньше «раза в день»
// было записано в четырёх местах печатной формы, и все четыре давали «8 раза
// в день» / «12 раза в день» — по-русски неверно (нужно «8 раз»), и это печаталось
// в рецепте. В БД 49 таких режимов (freq 8, 12, 30).
function freqTimesWord(n){
  const m100 = n % 100, m10 = n % 10;
  if (m100 >= 11 && m100 <= 14) return 'раз';
  if (m10 === 1) return 'раз';
  if (m10 >= 2 && m10 <= 4) return 'раза';
  return 'раз';
}
function formatFrequency(freq, style){
  if (freq == null || !isFinite(freq) || freq <= 0) return '—';
  if (style === 'short') return freq+' р/д';
  if (style === 'latin') return LATIN_FREQ[freq] || (freq+' '+freqTimesWord(freq)+' в день');
  return freq+' '+freqTimesWord(freq)+' в день';
}

function fillPrescriptionForm(){
  if(!activeDrug || !activeDisease) return;
  const w = parseFloat($('weight').value);
  const reg = getActiveRegimen();
  if(!reg){ toast('Нет схемы дозирования на выбранную возрастную группу'); return; }
  const {singleMg, dailyMg} = computeDose(reg, w);
  const refs = getDrugRefs(activeDrug);
  const mainRef = DB.drugs_reference[refs[0]];
  const form = mainRef.forms[activeFormIdx];

  // Header (Russian — as on real forms)
  const dateStr = $('patient-date').value || new Date().toLocaleDateString('ru-RU');
  $('rx-date').textContent = dateStr;
  $('rx-doctor').textContent = $('doctor-name').value || '________________________';

  // Rp: block — Latin drug names
  const drugsEl = $('rx-drugs');
  $('rx-date').textContent = $('patient-date').value || new Date().toLocaleDateString('ru-RU');
  $('rx-doctor').textContent = $('doctor-name').value || '—';
  const latinName = LATIN_INN[refs[0]] || mainRef.inn;
  const latinForm = LATIN_FORM[form.form_type] || form.form_type;
  const freqStr = formatFrequency(reg.freq_per_day, 'latin');
  const routeLat = LATIN_ROUTE[currentRouteGroup] || '';
  const routeRu = currentRouteGroup === 'po' ? 'внутрь' : (currentRouteGroup === 'im' ? 'внутримышечно' : 'внутривенно');

  let drugsHtml = '<div class="rx-drug-name">'+latinName+' '+form.concentration+'</div>';

  if(form.form_type === 'tablet' || form.form_type === 'capsule'){
    const strength = tabletStrengthMg(form);
    const tabsPerDose = strength ? singleMg / strength : NaN;
    if(tabsPerDose > 0 && !isNaN(tabsPerDose)){
      drugsHtml += '<div class="rx-dtd">D.t.d. N '+Math.ceil(tabsPerDose)+' in '+latinForm+'</div>';
      drugsHtml += renderCourseTotals(reg, reg.freq_per_day, tabsPerDose, latinForm);
    }
  }

  if(refs.length > 1){
    drugsHtml += '<div style="font-weight:bold;font-size:10pt;margin-top:4px;padding-top:4px;border-top:1px dashed #999">Комбинация: вторая линия</div>';
    refs.slice(1).forEach((refKey)=>{
      const ref = DB.drugs_reference[refKey];
      if(!ref) return;
      const clatin = LATIN_INN[refKey] || ref.inn;
      const cform = ref.forms[0];
      drugsHtml += '<div class="rx-drug-name">'+clatin+' '+(cform?cform.concentration:'')+'</div>';
    });
  }

  drugsEl.innerHTML = drugsHtml;

  // D.S. block — Russian instructions (as per regulation)
  const signaEl = $('rx-signa-text');
  let signa = '';
  if(form.form_type === 'tablet' || form.form_type === 'capsule'){
    const strength = tabletStrengthMg(form);
    const tabsPerDose = strength ? singleMg / strength : NaN;
    signa = (strength && tabsPerDose > 0)
      ? 'По '+tabsPerDose.toFixed(1).replace(/\.0$/,'')+' '+latinForm+' '+formatFrequency(reg.freq_per_day)+', '+routeRu
      : '';
  } else if(form.concentration_mg_per_ml){
    const ml = singleMg / form.concentration_mg_per_ml;
    signa = 'По '+ml.toFixed(1)+' мл ('+form.concentration+') внутрь '+formatFrequency(reg.freq_per_day);
  } else {
    signa = 'По '+fmtDose(singleMg, doseUnitOf(mainRef))+' '+routeRu+', '+formatFrequency(reg.freq_per_day);
  }
  if(currentRouteGroup === 'iv' && activeRouteKey === 'iv_infusion') signa += ', капельно за 30 мин';
  if(currentRouteGroup === 'iv' && activeRouteKey === 'iv_bolus') signa += ', медленно за 5 мин';
  signaEl.textContent = signa;

  // Course
  $('rx-course').textContent = 'Курс: '+formatDuration(reg)+(reg.duration_note?'. '+reg.duration_note:'');

  // Injection preparation
  const injEl = $('rx-injection-details');
  injEl.innerHTML = '';
  if(currentRouteGroup === 'im' || currentRouteGroup === 'iv'){
    const dil = mainRef.dilution;
    if(dil){
      const routeData = dil[activeRouteKey];
      if(routeData && routeData.solvent_options && routeData.solvent_options[activeVialIdx]){
        const v = routeData.solvent_options[activeVialIdx];
        let html = '<div class="rx-inj-block"><b>Solutio pro injectione:</b><br>';
        html += v.solvent+' — '+v.solvent_ml+' ml<br>';
        html += 'Vial: '+vialStrengthLabel(v, true)+'<br>';
        html += 'Concentratio finalis: '+vialConcentrationLabel(v, true)+'<br>';
        const mlForDose = injectableMlForDose(singleMg, v, true);
        html += 'Volumen pro dosi: '+mlForDose;
        html += '</div>';
        injEl.innerHTML = html;
      }
    }
  }
}
function formTypeRussian(t){
  const map = {
    'tablet':'Таблетки', 'capsule':'Капсулы', 'suspension':'Суспензия', 'syrup':'Сироп',
    'powder_for_suspension':'Порошок для приготовления суспензии', 'solution_iv':'Раствор для в/в введения',
    'solution_im':'Раствор для в/м введения', 'granules':'Гранулы', 'topical':'Крем/мазь наружно', 'suppository':'Суппозитории'
  };
  return map[t] || t;
}
function copyPrescription(){
  if(!activeDrug || !activeDisease){
    toast('Нет активного расчёта');
    return;
  }
  const w = parseFloat($('weight').value);
  const reg = getActiveRegimen();
  if(!reg){ toast('Нет схемы дозирования на выбранную возрастную группу'); return; }
  const {singleMg, dailyMg} = computeDose(reg, w);
  const ref = DB.drugs_reference[getDrugRefs(activeDrug)[0]];
  const form = ref.forms[activeFormIdx];
  const patient = $('patient-name').value || '—';
  const date = $('patient-date').value || new Date().toLocaleDateString('ru-RU');
  const doctor = $('doctor-name').value || '—';
  const age = $('patient-age').value || '—';
  let txt = 'НАЗНАЧЕНИЕ АНТИБИОТИКОТЕРАПИИ\n';
  txt += 'Дата: '+date+'\n';
  txt += 'Пациент: '+patient+' (возраст: '+age+', вес: '+w+' кг)\n';
  txt += 'Врач: '+doctor+'\n\n';
  txt += 'Диагноз: '+activeDisease.name+' (МКБ-10: '+activeDisease.mkb10.join(', ')+')\n';
  txt += 'КР МЗ РФ #'+activeDisease.cr_id+', '+activeDisease.cr_year+'\n\n';
  txt += 'Препарат: '+ref.inn+'\n';
  txt += 'Форма: '+form.concentration+'\n';
  txt += 'Разовая доза: '+fmtDose(singleMg, doseUnitOf(ref))+'\n';
  txt += 'Суточная доза: '+fmtDose(dailyMg, doseUnitOf(ref))+'\n';
  txt += 'Кратность: '+reg.freq_per_day+' р/д\n';
  txt += 'Курс: '+formatDuration(reg)+'\n';
  txt += 'Путь: '+routeKeyLabel(activeRouteKey || 'im')+'\n\n';
  if(activeDrug.indication_note) txt += 'Замечание: '+activeDrug.indication_note+'\n';
  txt += '\n⚠ ЧЕРНОВИК. Требует верификации по первоисточникам КР МЗ РФ.';
  navigator.clipboard.writeText(txt).then(()=>toast('Скопировано в буфер')).catch(()=>toast('Ошибка копирования'));
}
function saveToHistory(){
  if(!activeDrug || !activeDisease){ toast('Нет активного расчёта'); return; }
  const w = parseFloat($('weight').value);
  const reg = getActiveRegimen();
  if(!reg){ toast('Нет схемы дозирования на выбранную возрастную группу'); return; }
  const ref = DB.drugs_reference[getDrugRefs(activeDrug)[0]];
  const unit = doseUnitOf(ref);
  const {singleMg, dailyMg, noDose} = computeDose(reg, w, unit);
  // История — это запись расчёта. Сохранять «0 мг» вместо отсутствующей дозы
  // нельзя: в списке это неотличимо от реальной нулевой дозы.
  if(noDose){ toast('В КР не указана числовая доза — сохранять нечего'); return; }
  const entry = {
    ts: Date.now(),
    patient: $('patient-name').value || '',
    disease: activeDisease.name,
    drug: ref.inn,
    singleMg: Math.round(singleMg),
    dailyMg: Math.round(dailyMg),
    unit: unit,
    freq: reg.freq_per_day,
    duration: formatDuration(reg),
    weight: w,
    ageGroup: activeAge
  };
  const hist = JSON.parse(localStorage.getItem('antibio_history') || '[]');
  hist.unshift(entry);
  if(hist.length > 20) hist.length = 20;
  localStorage.setItem('antibio_history', JSON.stringify(hist));
  toast('Сохранено в историю');
}
function loadHistory(){
  const hist = JSON.parse(localStorage.getItem('antibio_history') || '[]');
  const list = $('history-list');
  list.innerHTML = '';
  if(hist.length === 0){
    list.innerHTML = '<p class="text-xs text-slate-400 text-center py-8">История пуста</p>';
    return;
  }
  hist.forEach((e, idx)=>{
    const div = document.createElement('div');
    div.className = 'premium-card p-3 text-xs cursor-pointer hover:bg-blue-50 dark:hover:bg-slate-700';
    const dt = new Date(e.ts);
    // Записи, сохранённые до появления поля unit, показываем в мг — иначе
    // история упала бы на undefined.
    const eUnit = e.unit || 'мг';
    div.innerHTML = '<div class="flex justify-between"><span class="font-bold text-slate-700 dark:text-slate-200">'+e.drug+'</span><span class="text-slate-400">'+dt.toLocaleDateString('ru-RU')+' '+dt.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'})+'</span></div><div class="text-slate-500 dark:text-slate-400 mt-1">'+e.disease+'</div><div class="text-slate-600 dark:text-slate-300 mt-1 font-bold">'+fmtDose(e.singleMg, eUnit)+' × '+e.freq+' р/д, курс '+e.duration+(e.patient?' • '+e.patient:'')+'</div>';
    list.appendChild(div);
  });
}
function openHistory(){
  loadHistory();
  $('history-drawer').classList.add('open');
  $('drawer-overlay').classList.add('open');
}
function closeHistory(){
  $('history-drawer').classList.remove('open');
  $('drawer-overlay').classList.remove('open');
}
function clearHistory(){
  if(confirm('Очистить всю историю?')){
    localStorage.removeItem('antibio_history');
    loadHistory();
    toast('История очищена');
  }
}
function updateHash(){
  if(!activeDisease || !activeDrug) return;
  const h = [activeDisease.id, activeScenario?activeScenario.id:'', activeLine?'L'+activeLine.line_number:''].join('/');
  history.replaceState(null, '', '#'+h);
}
function restoreFromHash(){
  const h = window.location.hash.slice(1);
  if(!h) return;
  const parts = h.split('/');
  const disease = DB.recommendations.find(d=>d.id === parts[0]);
  if(!disease) return;
  selectDisease(disease);
}
init();
</script>
