<script id="db-data" type="application/json">__DB_PLACEHOLDER__</script>
<script>
let DB = null;
let activeDisease = null, activeScenario = null, activeLine = null, activeDrug = null, activeFormIdx = 0, activeRegimenIdx = 0, activeRouteKey = null, activeVialIdx = 0;
let activeAge = 'child';
let userPickedAge = false;
let lastPickedAge = null;
let dbBlockingErrors = [];
let historyEntries = [];
let currentRouteGroup = 'all';
let personalCandidates = [];
let extractedReviewCandidates = [];

function $(id){return document.getElementById(id);}
function toast(msg){
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(()=>t.classList.remove('show'), 2500);
}
function validateDB(){
  const errs = [], warns = [];
  if(!DB || !DB.recommendations || !DB.drugs_reference){ errs.push('Нет БД'); return {errs,warns}; }
  const drugKeys = Object.keys(DB.drugs_reference).filter(k=>k!=='_note');
  DB.recommendations.forEach((r,i)=>{
    if(!r.id) errs.push('rec['+i+']: нет id');
    if(!r.mkb10||!r.mkb10.length) errs.push('rec['+i+'] '+r.id+': нет mkb10');
    if(!r.name) errs.push('rec['+i+']: нет name');
    if(!r.cr_id) warns.push('rec['+i+'] '+r.id+': нет cr_id');
    if(!r.cr_year) warns.push('rec['+i+'] '+r.id+': нет cr_year');
    (r.scenarios||[]).forEach((s,si)=>{
      if(!s.id) errs.push('rec['+i+'] '+r.id+'>scenario['+si+']: нет id');
      if(!s.name) errs.push('rec['+i+'] '+r.id+'>scenario['+si+']: нет name');
      (s.lines||[]).forEach((l,li)=>{
        if(l.line_number==null) errs.push('rec['+i+'] '+r.id+'>scenario['+si+']>line['+li+']: нет line_number');
        (l.drugs||[]).forEach((d,di)=>{
          if(d.drug_ref&&!drugKeys.includes(d.drug_ref)) errs.push('drug_ref "'+d.drug_ref+'" не найден в drugs_reference');
          if(d.combo_ref) d.combo_ref.forEach((cr,cdi)=>{ if(!drugKeys.includes(cr)) errs.push('combo_ref "'+cr+'" не найден'); });
          if(!d.route||!d.route.length) warns.push('rec['+i+'] '+r.id+'>drug '+d.drug_ref+': нет route');
          (d.regimens||[]).forEach((rg,ri)=>{
            if(!rg.freq_per_day) errs.push('rec['+i+'] '+r.id+'>drug '+d.drug_ref+' regimen['+ri+']: нет freq_per_day');
            if(!rg.duration_days) warns.push('rec['+i+'] '+r.id+'>drug '+d.drug_ref+' regimen['+ri+']: нет duration_days');
          });
        });
      });
    });
  });
  return {errs,warns};
}
// БД считается пригодной для расчёта только если blockingErrors пуст.
// Непротиворечивость — предупреждение, оно не блокирует расчёт.
function dbBlockReason(){
  if(!dbBlockingErrors.length) return '';
  return 'встроенная БД не прошла проверку целостности ('+dbBlockingErrors.length+' ошибок). Первые: '+dbBlockingErrors.slice(0,3).join('; ');
}
function dbTrustState(){
  const meta = (DB && DB.meta) || {};
  const status = String(meta.verification_status || 'draft').toLowerCase();
  return {
    status: status,
    verified: status === 'verified' || status === 'calculation_bound_verified',
    warning: meta.warning || 'статус проверки источников не указан',
    version: meta.version || '—',
    generated: meta.generated_at || '—'
  };
}
// FNV-1a по встроенному payload БД: детерминированный идентификатор сборки,
// который меняется при любой правке БД. Не требует правки build_html.py.
function buildFingerprint(){
  const el = $('db-data');
  const raw = (el && el.textContent) || '';
  let hash = 0x811c9dc5;
  for(let i=0;i<raw.length;i++){
    hash ^= raw.charCodeAt(i);
    hash = (hash + ((hash<<1)+(hash<<4)+(hash<<7)+(hash<<8)+(hash<<24))) >>> 0;
  }
  return hash.toString(16).toUpperCase().padStart(8,'0');
}
function buildIdentifier(){
  const t = dbTrustState();
  return 'ANTIBIO '+t.version+' • БД от '+t.generated+' • сборка '+buildFingerprint();
}
function renderTrustBanner(){
  const t = dbTrustState();
  const banner = $('trust-banner');
  if(banner){
    banner.dataset.verified = t.verified ? 'true' : 'false';
    banner.textContent = (t.verified ? 'ВЕРИФИЦИРОВАННАЯ БД' : 'НЕПРОВЕРЕННАЯ БД (ЧЕРНОВИК)')+' — '+t.warning;
  }
  const build = $('build-id');
  if(build) build.textContent = buildIdentifier();
}
// Статус источника попадает в текст и в разметку баннера, поэтому здесь он
// нормализуется до безопасного набора символов: значение из БД не должно
// иметь возможности стать разметкой.
function diseaseSourceStatus(d){
  if(!d) return 'unknown';
  if(d.calculation_blocked) return 'blocked';
  const raw = String(d.source_verification_status || 'UNVERIFIED').toUpperCase();
  return /^[A-Z0-9_]{1,64}$/.test(raw) ? raw : 'UNVERIFIED';
}
function init(){
  try{
    const raw = $('db-data').textContent.trim();
    DB = JSON.parse(raw);
    document.getElementById('verification-status').textContent = (DB.meta.verification_status||'draft').toUpperCase()+' • '+DB.meta.warning;
    document.getElementById('header-stats').textContent = 'КР МЗ РФ • '+DB.recommendations.length+' нозологий • '+Object.keys(DB.drugs_reference).filter(k=>k!=='_note').length+' препаратов';
    document.getElementById('empty-state-stats').textContent = DB.recommendations.length+' нозологий • '+Object.keys(DB.drugs_reference).filter(k=>k!=='_note').length+' препаратов • КР МЗ РФ';
    const v = validateDB();
    dbBlockingErrors = v.errs.slice();
    renderTrustBanner();
    const statusEl = document.getElementById('header-stats');
    if(v.errs.length){
      statusEl.textContent += ' • ❌ '+v.errs.length+' ош — расчёт заблокирован';
      statusEl.className = 'text-red-500 text-[10px] font-bold mt-0.5 uppercase tracking-widest italic';
    } else if(v.warns.length){
      statusEl.textContent += ' • ⚠️ '+v.warns.length+' пред';
      statusEl.className = 'text-amber-500 text-[10px] font-bold mt-0.5 uppercase tracking-widest italic';
    } else {
      statusEl.textContent += ' • ✓ БД';
    }
  }catch(e){
    // Текст исключения врачу не показываем: он может содержать фрагмент встроенной
    // БД, то есть недоверенные данные, и в клиническом интерфейсе это только шум.
    // Подробности остаются в консоли для того, кто чинит сборку.
    console.error('ANTIBIO: не удалось загрузить встроенную БД', e);
    const box = $('empty-state');
    box.textContent = '';
    const note = document.createElement('p');
    note.className = 'text-red-600 font-bold';
    note.textContent = 'Ошибка загрузки БД. Подробности — в консоли браузера.';
    box.appendChild(note);
    return;
  }
  document.querySelectorAll('#age-group button').forEach(b=>{
    b.onclick = ()=>{
      document.querySelectorAll('#age-group button').forEach(x=>x.classList.remove('active'));
      b.classList.add('active');
      activeAge = b.dataset.age;
      userPickedAge = true;
      lastPickedAge = activeAge;
      clearAgeInferenceNotice();
      if(activeDisease) renderScenarios();
      calculate();
    };
  });
  setupButtons();
  setupPersonalMode();
  setupTheme();
  initHistoryStore();
  loadHistory();
  if('serviceWorker' in navigator && (window.location.protocol === 'http:' || window.location.protocol === 'https:')){
    navigator.serviceWorker.register('./sw.js').catch(()=>{});
  }
  if(window.location.hash){
    setTimeout(restoreFromHash, 100);
  }
}
// Печать — только для фактически выполненного расчёта. Иначе распечатка
// уехала бы с дозой, которой нет.
function printBlocked(){
  if(!activeDrug){ toast('Выберите препарат'); return true; }
  const block = calculationBlockReason(parseFloat($('weight').value));
  if(block){ showDoseBlock(block); hideDoseResults(); toast('Печать заблокирована: расчёт не выполнен'); return true; }
  return false;
}
function setupButtons(){
  if($('btn-print')) $('btn-print').onclick = ()=>{ if(printBlocked()) return; fillPrescriptionForm(); window.print(); };
  if($('btn-print2')) $('btn-print2').onclick = ()=>{ if(printBlocked()) return; fillPrescriptionForm(); window.print(); };
  if($('btn-copy')) $('btn-copy').onclick = copyForMIS;
  if($('btn-copy-mis')) $('btn-copy-mis').onclick = copyForMIS;
  if($('btn-copy-rx')) $('btn-copy-rx').onclick = copyLatinRecipe;
  if($('btn-guideline-modal')) $('btn-guideline-modal').onclick = openGuidelineModal;
  if($('btn-save-history')) $('btn-save-history').onclick = saveToHistory;
  if($('btn-history')) $('btn-history').onclick = openHistory;
  if($('btn-theme')) $('btn-theme').onclick = toggleTheme;
