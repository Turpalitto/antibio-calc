    }
  } else {
    block.classList.add('hidden');
  }
}
function renderInjection(reg, form, ref, w, singleMg, dailyMg, capped, inconsistent){
  const dil = ref.dilution || {};
  let availableRoutes = [];
  if(dil.im && currentRouteGroup === 'im') availableRoutes.push('im');
  if((dil.iv_bolus || dil.iv_infusion) && currentRouteGroup === 'iv'){
    if(dil.iv_bolus) availableRoutes.push('iv_bolus');
    if(dil.iv_infusion) availableRoutes.push('iv_infusion');
  }
  if(availableRoutes.length === 0){
    if(dil.im) availableRoutes.push('im');
    else if(dil.iv_bolus) availableRoutes.push('iv_bolus');
    else if(dil.iv_infusion) availableRoutes.push('iv_infusion');
    else if(currentRouteGroup === 'im') availableRoutes.push('im');
    else availableRoutes.push('iv_infusion');
  }
  if(!activeRouteKey || !availableRoutes.includes(activeRouteKey)) activeRouteKey = availableRoutes[0];

  const routeSel = $('route-selector');
  routeSel.innerHTML = '';
  availableRoutes.forEach(k=>{
    const btn = document.createElement('button');
    btn.className = 'chip text-[10px] font-black uppercase rounded-lg px-2 py-1'+(k===activeRouteKey?' active':'');
    btn.textContent = routeKeyLabel(k);
    btn.onclick = ()=>{
      activeRouteKey = k; activeVialIdx = 0;
      routeSel.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      renderInjection(reg, form, ref, w, singleMg, dailyMg, capped);
    };
    routeSel.appendChild(btn);
  });

  const unit = doseUnitOf(ref);
  const routeData = dil[activeRouteKey] || {};
  $('inj-route-label').textContent = routeKeyLabel(activeRouteKey);
  $('inj-mg').textContent = (singleMg <= 0) ? '—' : (unit === 'ЕД' ? formatUnits(Math.round(singleMg)) : Math.round(singleMg));
  $('inj-unit').textContent = (singleMg <= 0) ? '' : unit;
  $('inj-freq').textContent = reg.freq_per_day ? reg.freq_per_day+' р/д' : '—';

  let selectedVial = null;
  if(routeData.solvent_options && routeData.solvent_options.length > 0){
    const vials = routeData.solvent_options;
    if(activeVialIdx >= vials.length) activeVialIdx = 0;
    selectedVial = vials[activeVialIdx];
    const vialSel = $('vial-selector');
    const vialList = $('vial-list');
    vialList.innerHTML = '';
    vials.forEach((v, idx)=>{
      const btn = document.createElement('button');
      btn.className = 'chip text-[10px] font-black rounded-lg px-2 py-1'+(idx===activeVialIdx?' active':'');
      const label = v.vial_mg ? v.vial_mg+' мг' : (v.vial_units ? formatUnits(v.vial_units)+' ЕД' : v.solvent);
      btn.textContent = label;
      btn.onclick = ()=>{
        activeVialIdx = idx;
        vialList.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        renderInjection(reg, form, ref, w, singleMg, dailyMg, capped);
      };
      vialList.appendChild(btn);
    });
    vialSel.classList.toggle('hidden', vials.length <= 1);
  } else {
    $('vial-selector').classList.add('hidden');
  }

  $('inj-ml').textContent = (singleMg <= 0) ? '—' : computeInjectableMl(singleMg, selectedVial);
  $('inj-day').textContent = (dailyMg <= 0) ? '—' : fmtDose(dailyMg, unit);
  $('inj-dur').textContent = reg.duration_days || '—';
  // Кратность приходит из БД — инструкция собирается узлами.
  const injInstr = $('inj-instruction');
  injInstr.textContent = '';
  const injIcon = document.createElement('i');
  injIcon.className = 'fas fa-syringe mr-2 text-orange-300';
  if(singleMg <= 0){
    const injText = document.createElement('span');
    injText.textContent = reg.duration_note || reg.regimen_label || 'Вводить по схеме клинических рекомендаций';
    injInstr.append(injIcon, injText);
  } else {
    const injLead = document.createElement('span');
    injLead.textContent = 'Ввести ';
    const injDose = document.createElement('b');
    injDose.textContent = fmtDose(singleMg, unit);
    const injTail = document.createElement('span');
    injTail.textContent = ' '+routeKeyLabel(activeRouteKey)+(reg.freq_per_day ? ' • '+reg.freq_per_day+' р/д' : '');
    injInstr.append(injIcon, injLead, injDose, injTail);
  }

  const rangeEl = $('inj-range');
  if(reg.dose_range_mg_kg_day && reg.dose_range_mg_kg_day.length === 2){
    rangeEl.classList.remove('hidden');
    rangeEl.textContent = 'Диапазон по КР: '+reg.dose_range_mg_kg_day[0]+'-'+reg.dose_range_mg_kg_day[1]+' '+unit+'/кг/сут';
  } else if(reg.dose_mg_kg_day){
    rangeEl.classList.remove('hidden');
    rangeEl.textContent = 'Доза по КР: '+reg.dose_mg_kg_day+' '+unit+'/кг/сут';
  } else rangeEl.classList.add('hidden');

  const warnEl = $('inj-max-warn');
  if(inconsistent){
    warnEl.querySelector('span').textContent = 'Данные БД несогласованы: разовая × кратность ≠ суточной. Расчёт выполнен по разовой дозе из КР — требуется проверка.';
    warnEl.classList.remove('hidden');
  } else if(capped){
    warnEl.querySelector('span').textContent = 'Превышена max суточная доза '+fmtDose(reg.max_daily_mg, unit)+'/сут — суточная и разовая дозы снижены до потолка ('+fmtDose(singleMg, unit)+' × '+reg.freq_per_day+' р/д). Проверьте режим по КР.';
    warnEl.classList.remove('hidden');
  } else warnEl.classList.add('hidden');

  renderDilutionBlock(ref, activeRouteKey, singleMg, selectedVial, routeData);
}
function routeKeyLabel(k){
  return k === 'im' ? 'в/м' : (k === 'iv_bolus' ? 'в/в струйно' : 'в/в капельно');
}
function computeInjectableMl(singleMg, vial){
  if(!vial) return '—';
  const conc = vial.final_concentration_mg_ml || vial.final_concentration_units_ml || 0;
  if(conc <= 0) return '—';
  const isUnits = !!vial.final_concentration_units_ml;
  const ml = singleMg / conc;
  return ml.toFixed(2)+' мл';
}
function renderDilutionBlock(ref, routeKey, singleMg, selectedVial, routeData){
  routeData = routeData || {};
  const warn = $('dilution-warn');
  const warnText = $('dilution-warn-text');
  let warnings = [];
  if(routeData.child_solvent_warning && activeAge !== 'adult') warnings.push(routeData.child_solvent_warning);
  if(routeData.contraindications) warnings.push(routeData.contraindications);
  if(ref.interactions && ref.interactions.indexOf('Ca')>=0 && routeKey !== 'im') warnings.push('Не смешивать с Ca-растворами.');
  if(warnings.length){
    // Предупреждения приходят из БД, разделитель — настоящие <br>, а не строка
    // разметки, склеенная с данными.
    warnText.textContent = '';
    warnings.forEach((text, index)=>{
      if(index > 0){
        warnText.appendChild(document.createElement('br'));
        warnText.appendChild(document.createElement('br'));
      }
      warnText.appendChild(document.createTextNode(text));
    });
    warn.classList.remove('hidden');
  } else warn.classList.add('hidden');

  const solBox = $('dilution-solvents');
  solBox.innerHTML = '';
  if(selectedVial){
    const div = document.createElement('div');
    div.className = 'dilution-solvent';
    const vial = selectedVial.vial_mg ? selectedVial.vial_mg+' мг' : (selectedVial.vial_units ? formatUnits(selectedVial.vial_units)+' ЕД' : '');
    const conc = selectedVial.final_concentration_mg_ml ? selectedVial.final_concentration_mg_ml+' мг/мл' : (selectedVial.final_concentration_units_ml ? formatUnits(selectedVial.final_concentration_units_ml)+' ЕД/мл' : '');
    const mlForDose = (selectedVial.final_concentration_mg_ml || selectedVial.final_concentration_units_ml) ? (singleMg / (selectedVial.final_concentration_mg_ml || selectedVial.final_concentration_units_ml)).toFixed(2)+' мл' : '';
    // Растворитель и примечание к флакону приходят из БД: узлы + textContent.
    const solventHead = document.createElement('div');
    solventHead.className = 'font-black text-orange-700 dark:text-orange-400 mb-1';
    solventHead.textContent = selectedVial.solvent;
    div.appendChild(solventHead);
    const fact = text => {
      const row = document.createElement('div');
      row.textContent = text;
      return row;
    };
    div.append(
      fact('Флакон: '+vial),
      fact('Растворитель: '+selectedVial.solvent_ml+' мл'),
      fact('Итог: '+selectedVial.final_volume_ml+' мл, '+conc)
    );
    if(mlForDose){
      const perDose = document.createElement('div');
      perDose.className = 'mt-1 text-orange-900 dark:text-orange-300 font-black';
      perDose.textContent = 'На дозу: '+mlForDose;
      div.appendChild(perDose);
    }
    if(selectedVial.notes){
      const vialNote = document.createElement('div');
      vialNote.className = 'mt-1 text-[10px] italic opacity-80';
      vialNote.textContent = selectedVial.notes;
      div.appendChild(vialNote);
    }
    solBox.appendChild(div);
  }

  const caut = $('dilution-cautions');
  if(routeData.cautions){
    $('dilution-cautions-text').textContent = routeData.cautions;
    caut.classList.remove('hidden');
  } else caut.classList.add('hidden');

  const stepsEl = $('dilution-steps');
  stepsEl.innerHTML = '';
  ((routeData.steps) || []).forEach(s=>{
    const li = document.createElement('li');
    li.className = 'step';
    const span = document.createElement('span');
    span.textContent = s.replace(/^\d+\.\s*/, '');
    li.appendChild(span);
    stepsEl.appendChild(li);
  });
}
function renderComboComponents(refs, reg, w){
  if(refs.length === 0) return;
  const block = $('combo-block');
  block.classList.remove('hidden');
  block.innerHTML = '<div class="text-[11px] font-black text-slate-400 uppercase tracking-widest ml-2">Компоненты комбинации (применяются одновременно)</div>';
  refs.forEach(refKey=>{
    const ref = DB.drugs_reference[refKey];
    if(!ref) return;
    // У каждого компонента может быть собственный режим (component_regimens), иначе — режим основной линии
    const compReg = (reg.component_regimens && reg.component_regimens[refKey]) || reg;
    const unit = doseUnitOf(ref);
    const {singleMg, dailyMg, needWeight} = computeDose(compReg, w, unit);
    // МНН компонента, кратность, длительность и примечание приходят из БД:
    // карточка собирается узлами, а не строкой разметки.
    const card = document.createElement('div');
    card.className = 'premium-card p-4 text-sm';
    const innEl = document.createElement('div');
    innEl.className = 'font-bold text-slate-800 dark:text-slate-200 mb-1';
    innEl.textContent = ref.inn;
    const doseEl = document.createElement('div');
    doseEl.className = 'text-xs text-slate-600 dark:text-slate-400';
    if(needWeight){
      doseEl.textContent = 'Введите вес пациента — доза по '+unit+'/кг';
    } else {
      const lead = document.createElement('span');
      lead.textContent = 'По ';
      const dose = document.createElement('b');
      dose.textContent = fmtDose(singleMg, unit);
      const mid = document.createElement('span');
      mid.textContent = ' '+compReg.freq_per_day+' р/д'+(compReg.duration_days ? ' • '+compReg.duration_days+' дн' : '')+' ';
      const daily = document.createElement('span');
      daily.className = 'opacity-70';
      daily.textContent = '(сут. '+fmtDose(dailyMg, unit)+')';
      doseEl.append(lead, dose, mid, daily);
    }
    card.append(innEl, doseEl);
    if(compReg.component_note){
      const role = document.createElement('div');
      role.className = 'text-[11px] text-slate-500 dark:text-slate-500 mt-1';
      role.textContent = compReg.component_note;
      card.appendChild(role);
    }
    block.appendChild(card);
  });
}
function formatUnits(n){
  if(n >= 1000000) return (n/1000000).toString().replace('.0','')+' млн';
  if(n >= 1000) return (n/1000).toString().replace('.0','')+' тыс';
  return n.toString();
}
function renderDrugMeta(ref, reg){
