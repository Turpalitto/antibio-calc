function fillPrescriptionForm(){
  if(!activeDrug || !activeDisease) return;
  const w = parseFloat($('weight').value);
  const block = calculationBlockReason(w);
  if(block){
    // Печать заблокирована, но сам факт блокировки попадает в бланк — врач
    // не должен получить распечатку без объяснения, почему расчёта нет.
    $('rx-trust-line').textContent = block;
    $('rx-build-line').textContent = buildIdentifier();
    return;
  }
  const reg = getActiveRegimen();
  if(!reg) return;
  const refs = getDrugRefs(activeDrug);
  const mainRef = DB.drugs_reference[refs[0]];
  const unit = doseUnitOf(mainRef);
  const {singleMg, dailyMg} = computeDose(reg, w, unit);
  const form = mainRef.forms[activeFormIdx];

  // Статус БД и идентификатор сборки печатаются вместе с рецептом
  $('rx-trust-line').textContent = (dbTrustState().verified ? 'ВЕРИФИЦИРОВАННАЯ БД. ' : 'НЕПРОВЕРЕННАЯ БД (ЧЕРНОВИК) — расчёт справочный, сверьте схему с КР. ')+
    'Источник: КР МЗ РФ #'+(activeDisease.cr_id || '—')+(activeDisease.cr_year ? ' ('+activeDisease.cr_year+')' : '')+
    ' • source_verification_status: '+diseaseSourceStatus(activeDisease)+
    ' • группа: '+ageGroupLabel(activeAge)+(w>0 ? ' • вес: '+w+' кг' : '');
  $('rx-build-line').textContent = buildIdentifier();

  // Header (Russian — as on real forms)
  const dateStr = $('patient-date').value || new Date().toLocaleDateString('ru-RU');
  $('rx-date').textContent = dateStr;
  $('rx-doctor').textContent = $('doctor-name').value || '—';

  // Rp: block — Latin drug names. Названия и концентрации приходят из БД,
  // поэтому бланк собирается узлами, а не строкой разметки.
  const drugsEl = $('rx-drugs');
  const latinName = LATIN_INN[refs[0]] || mainRef.inn;
  const latinForm = LATIN_FORM[form.form_type] || form.form_type;
  const routeRu = currentRouteGroup === 'po' ? 'внутрь' : (currentRouteGroup === 'im' ? 'внутримышечно' : (currentRouteGroup === 'iv' ? 'внутривенно' : 'местно'));

  const rxLine = (className, text) => {
    const div = document.createElement('div');
    if(className) div.className = className;
    div.textContent = text;
    return div;
  };

  drugsEl.textContent = '';
  drugsEl.appendChild(rxLine('rx-drug-name', latinName+' '+(form.concentration || '')));

  if((form.form_type === 'tablet' || form.form_type === 'capsule') && singleMg > 0){
    const tabsPerDose = singleMg / parseFloat(form.concentration);
    const totalDoses = reg.freq_per_day * (parseInt(reg.duration_days) || 0);
    if(tabsPerDose > 0 && !isNaN(tabsPerDose)){
      drugsEl.appendChild(rxLine('rx-dtd', 'D.t.d. N '+Math.ceil(tabsPerDose)+' in '+latinForm));
    }
    if(totalDoses > 0 && !isNaN(totalDoses)){
      drugsEl.appendChild(rxLine('rx-dtd', '(для курса: '+(totalDoses * Math.ceil(tabsPerDose))+' '+latinForm+')'));
    }
  }

  if(refs.length > 1){
    const comboMarker = document.createElement('div');
    comboMarker.setAttribute('style', 'font-weight:bold;font-size:10pt;margin-top:4px;padding-top:4px;border-top:1px dashed #999');
    comboMarker.textContent = 'Комбинация: вторая линия';
    drugsEl.appendChild(comboMarker);
    refs.slice(1).forEach((refKey)=>{
      const ref = DB.drugs_reference[refKey];
      if(!ref) return;
      const clatin = LATIN_INN[refKey] || ref.inn;
      const cform = ref.forms[0];
      drugsEl.appendChild(rxLine('rx-drug-name', clatin+' '+(cform?cform.concentration:'')));
    });
  }

  // D.S. block — Russian instructions (as per regulation)
  const signaEl = $('rx-signa-text');
