<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#2563eb">
<link rel="manifest" href="manifest.webmanifest">
<title>AntibioAudit — КР МЗ РФ | Калькулятор доз</title>
<script src="./vendor/tailwind.js"></script>
<script>
tailwind.config = { darkMode: 'class' };
</script>
<link href="./vendor/css/all.min.css" rel="stylesheet">
<style>
@import url('./vendor/css/fonts.css');
:root{
  --primary:#2563eb;--primary-hover:#1d4ed8;--primary-light:#eff6ff;--primary-glow:rgba(37,99,235,0.25);
  --success:#059669;--success-glow:rgba(5,150,105,0.2);
  --warning:#d97706;--danger:#dc2626;
  --slate-50:#f8fafc;--slate-100:#f1f5f9;--slate-200:#e2e8f0;--slate-300:#cbd5e1;--slate-400:#94a3b8;--slate-500:#64748b;--slate-700:#334155;--slate-800:#1e293b;--slate-900:#0f172a;
  --card-bg:rgba(255,255,255,0.92);--card-border:rgba(226,232,240,0.9);
  --card-shadow:0 10px 30px -5px rgba(15,23,42,0.04),0 4px 10px -2px rgba(15,23,42,0.02);
  --card-hover-shadow:0 20px 35px -8px rgba(15,23,42,0.08),0 8px 16px -4px rgba(15,23,42,0.04);
}
.dark{
  --slate-50:#090d16;--slate-100:#131b2e;--slate-200:#1e293b;--card-bg:rgba(19,27,46,0.85);--card-border:rgba(255,255,255,0.08);
  --card-shadow:0 12px 35px -8px rgba(0,0,0,0.5);--card-hover-shadow:0 25px 45px -10px rgba(0,0,0,0.7);
}
html{scroll-behavior:smooth}
body{
  font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,system-ui,Segoe UI,Roboto,sans-serif;
  background:radial-gradient(circle at 12% 8%, rgba(37,99,235,0.07) 0%, transparent 45%),
             radial-gradient(circle at 88% 18%, rgba(14,165,233,0.06) 0%, transparent 40%),
             radial-gradient(circle at 50% 95%, rgba(99,102,241,0.04) 0%, transparent 50%),
             #f8fafc;
  color:var(--slate-800);
  line-height:1.5;
  letter-spacing:-0.01em;
  min-height:100vh;
}
.dark body{
  background:radial-gradient(circle at 12% 8%, rgba(37,99,235,0.18) 0%, transparent 50%),
             radial-gradient(circle at 88% 18%, rgba(14,165,233,0.12) 0%, transparent 45%),
             radial-gradient(circle at 50% 95%, rgba(99,102,241,0.10) 0%, transparent 50%),
             #0a0f1d;
  color:#e2e8f0;
}
.premium-card{
  background:var(--card-bg);
  backdrop-filter:blur(24px);
  -webkit-backdrop-filter:blur(24px);
  border-radius:24px;
  border:1px solid var(--card-border);
  box-shadow:var(--card-shadow);
  transition:all .28s cubic-bezier(0.16, 1, 0.3, 1);
}
.premium-card:hover{
  box-shadow:var(--card-hover-shadow);
}
.input-field{
  background:var(--slate-100);
  border:2px solid transparent;
  transition:all .2s ease;
  color:var(--slate-800);
}
.dark .input-field{background:#0b1120;color:#e2e8f0;border-color:rgba(255,255,255,0.04)}
.input-field:focus{
  background:#fff;
  border-color:var(--primary);
  outline:none;
  box-shadow:0 0 0 4px var(--primary-glow);
}
.dark .input-field:focus{background:#0b1120;border-color:var(--primary)}
.chip{
  cursor:pointer;
  border:1.5px solid var(--slate-200);
  transition:all .2s cubic-bezier(0.16, 1, 0.3, 1);
  font-weight:700;
  background:#fff;
}
.dark .chip{background:#17223b;border-color:#2a3854;color:#e2e8f0}
.chip:hover{
  border-color:var(--primary);
  transform:translateY(-1.5px);
}
.chip:active{transform:translateY(0)}
.chip.active{
  background:linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
  color:#fff;
  border-color:transparent;
  box-shadow:0 4px 14px var(--primary-glow);
}
.chip.line-1{border-color:#a7f3d0}
.chip.line-1.active{background:linear-gradient(135deg, #059669 0%, #10b981 100%);border-color:transparent;box-shadow:0 4px 14px var(--success-glow)}
.chip.line-2{border-color:#bfdbfe}
.chip.line-2.active{background:linear-gradient(135deg, #1e40af 0%, #2563eb 100%);border-color:transparent;box-shadow:0 4px 14px var(--primary-glow)}
.chip.line-0{border-color:#fde68a}
.chip.line-0.active{background:linear-gradient(135deg, #d97706 0%, #f59e0b 100%);border-color:transparent;color:#fff}
.drug-card{
  cursor:pointer;
  border:1.5px solid var(--slate-200);
  transition:all .25s cubic-bezier(0.16, 1, 0.3, 1);
  background:#fff;
  border-radius:18px;
}
.dark .drug-card{background:#151f38;border-color:#263554}
.drug-card:hover{
  border-color:var(--primary);
  transform:translateY(-2px);
  box-shadow:0 12px 24px -6px rgba(37,99,235,0.12);
}
.drug-card.active{
  border-color:var(--primary);
  background:linear-gradient(to right, #eff6ff, #ffffff);
  box-shadow:0 8px 20px -4px rgba(37,99,235,0.18);
}
.dark .drug-card.active{
  background:linear-gradient(to right, #172750, #131d38);
  border-color:#3b82f6;
}
.scenario-card.active{
  border-color:var(--primary);
  background:linear-gradient(to right, #eff6ff, #ffffff);
  box-shadow:0 8px 20px -4px rgba(37,99,235,0.18);
}
.dark .scenario-card.active{background:linear-gradient(to right, #172750, #131d38);border-color:#3b82f6}
.res-box{
  background:linear-gradient(140deg, #1e3a8a 0%, #1e40af 40%, #2563eb 80%, #3b82f6 100%);
  box-shadow:0 25px 45px -10px rgba(37,99,235,0.38), 0 8px 16px -4px rgba(37,99,235,0.2);
  border:1px solid rgba(255,255,255,0.25);
  position:relative;
  overflow:hidden;
}
.res-box::after{
  content:'';position:absolute;top:-40%;right:-20%;width:350px;height:350px;
  background:radial-gradient(circle, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 70%);
  pointer-events:none;
}
.inj-box{
  background:linear-gradient(140deg, #7c2d12 0%, #9a3412 40%, #c2410c 80%, #ea580c 100%);
  box-shadow:0 25px 45px -10px rgba(194,65,12,0.38), 0 8px 16px -4px rgba(194,65,12,0.2);
  border:1px solid rgba(255,255,255,0.25);
  position:relative;
  overflow:hidden;
}
.inj-box::after{
  content:'';position:absolute;top:-40%;right:-20%;width:350px;height:350px;
  background:radial-gradient(circle, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 70%);
  pointer-events:none;
}
.badge{
  font-size:10px;font-weight:800;padding:3px 9px;border-radius:8px;text-transform:uppercase;letter-spacing:0.04em;
}
.metric-tile{
  background:rgba(255,255,255,0.12);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,0.22);
  border-radius:18px;
  padding:12px 10px;
  transition:all .25s cubic-bezier(0.16, 1, 0.3, 1);
}
.metric-tile:hover{
  background:rgba(255,255,255,0.18);
  border-color:rgba(255,255,255,0.38);
  transform:translateY(-1.5px);
}
.quick-weight-chip{
  padding:5px 12px;
  border-radius:12px;
  font-size:11px;
  font-weight:800;
  border:1.5px solid var(--slate-200);
  background:var(--slate-100);
  color:var(--slate-700);
  cursor:pointer;
  transition:all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  white-space:nowrap;
}
.dark .quick-weight-chip{
  background:#131d33;
  border-color:#23314e;
  color:#94a3b8;
}
.quick-weight-chip:hover{
  border-color:var(--primary);
  color:var(--primary);
  transform:translateY(-1px);
}
.quick-weight-chip.active{
  background:var(--primary);
  border-color:var(--primary);
  color:#fff;
  box-shadow:0 4px 12px var(--primary-glow);
}
.quick-disease-tag{
  padding:5px 11px;
  border-radius:12px;
  font-size:11px;
  font-weight:700;
  border:1.5px solid var(--slate-200);
  background:#fff;
  color:var(--slate-700);
  cursor:pointer;
  transition:all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  display:inline-flex;
  align-items:center;
  gap:4px;
  white-space:nowrap;
}
.dark .quick-disease-tag{
  background:#151f38;
  border-color:#263554;
  color:#cbd5e1;
}
.quick-disease-tag:hover{
  border-color:var(--primary);
  color:var(--primary);
  background:var(--primary-light);
  transform:translateY(-1px);
}
.dark .quick-disease-tag:hover{
  background:#1e293b;
  border-color:#3b82f6;
  color:#93c5fd;
}
.action-btn{
  transition:all .2s cubic-bezier(0.16, 1, 0.3, 1);
  cursor:pointer;
  user-select:none;
}
.action-btn:hover{
  transform:translateY(-1.5px);
  box-shadow:0 8px 18px -4px rgba(15,23,42,0.12);
}
.action-btn:active{
  transform:translateY(0);
}
.pulse-dot{
  width:8px;height:8px;border-radius:50%;background:#10b981;
  box-shadow:0 0 0 0 rgba(16,185,129,0.7);
  animation:pulseGreen 2s infinite;
  display:inline-block;
  flex-shrink:0;
}
@keyframes pulseGreen{
  0%{transform:scale(0.95);box-shadow:0 0 0 0 rgba(16,185,129,0.7);}
  70%{transform:scale(1);box-shadow:0 0 0 6px rgba(16,185,129,0);}
  100%{transform:scale(0.95);box-shadow:0 0 0 0 rgba(16,185,129,0);}
}
.tabular-num{font-variant-numeric:tabular-nums;letter-spacing:-0.02em}
@keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.animate-in{animation:fadeIn .35s cubic-bezier(0.16, 1, 0.3, 1) forwards}
.step{counter-increment:step}
.step::before{
  content:counter(step);display:inline-flex;align-items:center;justify-content:center;
  width:24px;height:24px;background:var(--primary);color:#fff;border-radius:50%;
  font-size:11px;font-weight:800;margin-right:10px;flex-shrink:0;box-shadow:0 2px 8px var(--primary-glow);
}
.steps{counter-reset:step;list-style:none;padding-left:0}
.steps li{padding:7px 0;display:flex;align-items:flex-start;font-size:13px;line-height:1.5}
.dilution-solvent{
  background:#fff7ed;border:1.5px solid #fed7aa;border-radius:14px;padding:12px 14px;
  font-size:12px;font-weight:600;color:#9a3412;box-shadow:0 2px 8px rgba(251,146,60,0.08);
}
.dark .dilution-solvent{background:#321506;border-color:#7c2d12;color:#fed7aa}
.scrollbar::-webkit-scrollbar{width:6px;height:6px}
.scrollbar::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
.dark .scrollbar::-webkit-scrollbar-thumb{background:#334155}
.route-tab.active{background:var(--primary);color:#fff;border-color:var(--primary);box-shadow:0 3px 10px var(--primary-glow)}
.toast{
  position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(100px);
  background:rgba(15,23,42,0.92);backdrop-filter:blur(12px);color:#fff;
  padding:12px 24px;border-radius:16px;font-weight:700;font-size:13px;
  box-shadow:0 15px 35px rgba(0,0,0,0.3);z-index:9999;opacity:0;transition:all .3s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events:none;border:1px solid rgba(255,255,255,0.1);
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
@media (max-width:768px){
  .mobile-nav{display:flex}
  body{padding-bottom:75px}
}
@media print{
  body>*{display:none!important}
  #prescription-form{display:block!important}
  body{background:#fff!important;padding:0;margin:0}
  @page{size:A4;margin:8mm}
}
.print-only{display:none}
.trust-banner{
  margin:0;padding:9px 20px;background:#7f1d1d;color:#fff;font-size:11px;line-height:1.45;
  font-weight:800;letter-spacing:.02em;border-bottom:2px solid #f87171;
}
.trust-banner[data-verified="true"]{background:#065f46;border-bottom-color:#34d399}
.drawer{
  position:fixed;top:0;right:-380px;width:380px;max-width:90vw;height:100vh;
  background:var(--card-bg);backdrop-filter:blur(24px);box-shadow:-15px 0 40px rgba(0,0,0,.15);
  z-index:1000;transition:right .35s cubic-bezier(0.16, 1, 0.3, 1);overflow-y:auto;
  border-left:1px solid var(--card-border);
}
.dark .drawer{background:#111827}
.drawer.open{right:0}
.drawer-overlay{
  position:fixed;inset:0;background:rgba(15,23,42,0.45);backdrop-filter:blur(4px);
  z-index:999;opacity:0;pointer-events:none;transition:opacity .3s ease;
}
.drawer-overlay.open{opacity:1;pointer-events:auto}
.personal-banner{
  position:sticky;top:0;z-index:900;background:#7f1d1d;color:#fff;
  border-bottom:2px solid #f87171;box-shadow:0 8px 20px rgba(127,29,29,.25);
}
.personal-status[data-state="ready"]{color:#059669}.personal-status[data-state="blocked"],.personal-status[data-state="error"]{color:#dc2626}.personal-status[data-state="checking"]{color:#d97706}
.dark .personal-status[data-state="ready"]{color:#34d399}.dark .personal-status[data-state="blocked"],.dark .personal-status[data-state="error"]{color:#f87171}.dark .personal-status[data-state="checking"]{color:#fbbf24}
.disclaimer-banner{
  margin:0;padding:12px 20px;background:#fffbeb;border-bottom:1.5px solid #f59e0b;
  color:#78350f;font-size:12px;line-height:1.5;width:100%;box-sizing:border-box;z-index:900;
}
.dark .disclaimer-banner{background:#2a1a08;border-bottom-color:#b45309;color:#fef3c7}
@media print{ .disclaimer-banner{display:none!important} }

/* Offline icon fallbacks */
.fa-user-md:not(.fa-solid):not(.fa-regular)::before{content:"🩺\00a0"}
.fa-history:not(.fa-solid):not(.fa-regular)::before{content:"⏱\00a0"}
.fa-print:not(.fa-solid):not(.fa-regular)::before{content:"🖨\00a0"}
.fa-moon:not(.fa-solid):not(.fa-regular)::before{content:"🌙"}
.fa-sun:not(.fa-solid):not(.fa-regular)::before{content:"☀️"}
.fa-search:not(.fa-solid):not(.fa-regular)::before{content:"🔍\00a0"}
.fa-times-circle:not(.fa-solid):not(.fa-regular)::before,.fa-times:not(.fa-solid):not(.fa-regular)::before{content:"✕"}
.fa-check-circle:not(.fa-solid):not(.fa-regular)::before{content:"✓\00a0"}
.fa-copy:not(.fa-solid):not(.fa-regular)::before{content:"📋\00a0"}
.fa-bookmark:not(.fa-solid):not(.fa-regular)::before{content:"🔖\00a0"}
.fa-flask:not(.fa-solid):not(.fa-regular)::before{content:"🧪\00a0"}
.fa-syringe:not(.fa-solid):not(.fa-regular)::before{content:"💉\00a0"}
.fa-pills:not(.fa-solid):not(.fa-regular)::before,.fa-pill:not(.fa-solid):not(.fa-regular)::before{content:"💊\00a0"}
.fa-exclamation-triangle:not(.fa-solid):not(.fa-regular)::before,.fa-triangle-exclamation:not(.fa-solid):not(.fa-regular)::before{content:"⚠️\00a0"}
.fa-exclamation-circle:not(.fa-solid):not(.fa-regular)::before,.fa-circle-info:not(.fa-solid):not(.fa-regular)::before{content:"ℹ️\00a0"}
.fa-book-medical:not(.fa-solid):not(.fa-regular)::before,.fa-stethoscope:not(.fa-solid):not(.fa-regular)::before{content:"📋\00a0"}
.fa-trash:not(.fa-solid):not(.fa-regular)::before{content:"🗑\00a0"}
.fa-chevron-right:not(.fa-solid):not(.fa-regular)::before{content:"›"}
.fa-snowflake:not(.fa-solid):not(.fa-regular)::before{content:"❄️\00a0"}
.fa-link:not(.fa-solid):not(.fa-regular)::before{content:"🔗\00a0"}
.fa-award:not(.fa-solid):not(.fa-regular)::before{content:"🏅\00a0"}
.fa-receipt:not(.fa-solid):not(.fa-regular)::before{content:"📜\00a0"}
.fa-file-medical:not(.fa-solid):not(.fa-regular)::before{content:"📁\00a0"}
.fa-shield-virus:not(.fa-solid):not(.fa-regular)::before{content:"🛡️\00a0"}
.fa-box:not(.fa-solid):not(.fa-regular)::before,.fa-box-open:not(.fa-solid):not(.fa-regular)::before{content:"📦\00a0"}
</style>
</head>
<body class="antialiased pb-12">
<div id="trust-banner" class="trust-banner no-print" data-verified="false" role="alert" aria-live="assertive"></div>
<div id="personal-mode-banner" class="personal-banner hidden no-print px-4 py-3 text-center text-xs font-black uppercase tracking-wider" role="alert" aria-live="assertive">
  OWNER_REVIEWED_EXPERIMENTAL — локальный режим врача-владельца; схема не имеет независимого production-одобрения. Проверяйте источник и расчёт.
</div>
<div class="max-w-4xl mx-auto px-4 md:px-8 pt-6 md:pt-8">

  <header class="mb-6 no-print">
    <div class="flex items-center justify-between gap-4 flex-wrap pb-4 border-b border-slate-200/80 dark:border-slate-800">
      <div class="flex items-center gap-3.5">
        <div class="inline-flex items-center justify-center w-12 h-12 bg-gradient-to-tr from-blue-600 to-indigo-600 text-white rounded-2xl shadow-md shadow-blue-600/20 flex-shrink-0">
          <i class="fas fa-user-md text-xl"></i>
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-2xl md:text-3xl font-black tracking-tight text-slate-900 dark:text-white">Antibio<span class="text-blue-600">Audit</span></h1>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 shadow-sm">
              <span class="pulse-dot"></span>
              КР МЗ РФ 2024
            </span>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mt-0.5 tracking-wide" id="header-stats">120 нозологий • Оффлайн PWA • 48 антибиотиков</p>
          <p class="text-slate-400 dark:text-slate-500 text-[9px] font-black mt-0.5 tracking-wide uppercase" id="build-id"></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="btn-history" class="action-btn text-xs font-black uppercase tracking-wider text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 hover:text-blue-600 flex items-center gap-1.5 shadow-sm" title="История расчётов">
          <i class="fas fa-history text-blue-500"></i><span class="hidden sm:inline">История</span>
        </button>
        <button id="btn-print" class="action-btn text-xs font-black uppercase tracking-wider text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 hover:text-blue-600 flex items-center gap-1.5 shadow-sm" title="Печать/PDF">
          <i class="fas fa-print text-slate-500"></i><span class="hidden sm:inline">Печать</span>
        </button>
        <button id="btn-theme" class="action-btn text-xs font-black uppercase tracking-wider text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 hover:text-blue-600 shadow-sm" title="Тема">
          <i class="fas fa-moon" id="theme-icon"></i>
        </button>
      </div>
    </div>

    <!-- Patient Metadata Card -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 mt-4 p-3 rounded-2xl bg-white/60 dark:bg-slate-800/60 backdrop-blur-md border border-slate-200/80 dark:border-slate-700/80 shadow-sm">
      <input type="text" id="patient-name" placeholder="Ф.И.О. пациента" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
      <input type="text" id="patient-date" placeholder="Дата" class="input-field rounded-xl px-3 py-2 text-xs font-bold" onfocus="this.type='date'" onblur="if(!this.value)this.type='text'">
      <input type="number" id="patient-age" placeholder="Возраст" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
      <input type="text" id="doctor-name" placeholder="Врач" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
    </div>
  </header>

  <div class="space-y-5">

    <section class="premium-card p-4 md:p-6 no-print" id="personal-mode-control">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="text-[11px] font-black text-slate-500 dark:text-slate-300 uppercase tracking-widest">Личный режим врача</div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Опциональный локальный API v2. Обычный калькулятор работает независимо от API.</p>
        </div>
        <label class="inline-flex items-center gap-2 cursor-pointer shrink-0">
          <input id="personal-mode-toggle" type="checkbox" class="w-5 h-5 accent-blue-600" aria-controls="personal-mode-panel">
          <span class="text-[10px] font-black uppercase">Включить</span>
        </label>
      </div>
      <div id="personal-mode-panel" class="hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-700 space-y-4">
