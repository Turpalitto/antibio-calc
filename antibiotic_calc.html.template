}
function metaRow(k, v){
  const row = document.createElement('div');
  row.className = 'flex justify-between gap-3';
  const key = document.createElement('span');
  key.className = 'text-slate-400 dark:text-slate-500 font-black uppercase text-[10px] tracking-widest flex-shrink-0';
  key.textContent = k;
  const value = document.createElement('span');
  value.className = 'text-slate-700 dark:text-slate-300 font-semibold text-right';
  value.textContent = v;
  row.append(key, value);
  return row;
}
