// Единая логика предупреждения по весу (валидация значения + требование веса для мг/кг режимов)
// Блокируется только то, что делает дозу НЕ пациент-специфичной либо физически невозможно.
// Вес < 40 кг у взрослого — редок, но реален (низкорослые, кахектичные пациенты): это
// предупреждение, а не тупик — блокировка лишила бы врача возможности назначить дозу вообще.
// Опасен обратный случай: детский мг/кг-режим с взрослым весом даёт передозировку.
function weightBlockReason(w, age){
  if(!(w > 0)) return '';
  if(w < 1) return 'Вес '+w+' кг — неправдоподобное значение (< 1 кг). Расчёт заблокирован: доза не может быть пациент-специфичной. Проверьте вес.';
  if(w > 250) return 'Вес '+w+' кг — вне рабочего диапазона (> 250 кг). Расчёт заблокирован: проверьте вес пациента.';
  if(w >= 40 && age === 'child') return 'Вес '+w+' кг при возрастной группе «дети»: мг/кг-дозирование по детской схеме с таким весом даёт передозировку. Расчёт заблокирован — проверьте возрастную группу и вес.';
  if(w >= 40 && age === 'neonate') return 'Вес '+w+' кг при возрастной группе «новорождённые» (0–28 дней): основание дозирования противоречиво. Расчёт заблокирован — проверьте возраст и группу.';
  return '';
}
function weightWarnReason(w, age){
  if(!(w > 0)) return '';
  if(weightBlockReason(w, age)) return '';
  if(w < 40 && age === 'adult') return 'Вес '+w+' кг при возрастной группе «взрослые» — редкое, но возможное сочетание. Проверьте, что возрастная группа выбрана верно: расчёт использует фиксированную дозу для взрослых, она не зависит от веса.';
  return '';
}
function updateWeightWarn(needWeight){
  const warn = $('weight-warn');
  const w = parseFloat($('weight').value);
  const block = weightBlockReason(w, activeAge);
  const caution = weightWarnReason(w, activeAge);
  let msg = block || caution;
  if(!msg){
    if(!w){
      if(needWeight) msg = 'Для этого режима нужен вес пациента — доза рассчитывается по мг/кг.';
    } else if(w < 40 && activeAge === 'neonate'){
      msg = 'Вес <40 кг при группе «новорождённые» — уточните возрастную группу.';
    }
  }
  if(msg){ warn.querySelector('span').textContent = msg; warn.classList.remove('hidden'); warn.dataset.blocking = block ? 'true' : 'false'; }
  else { warn.classList.add('hidden'); warn.dataset.blocking = 'false'; }
}
function showAgeInferenceNotice(w, inferred, previous){
  const el = $('age-infer-notice');
  if(!el) return;
  if(!inferred || !previous || inferred === previous){ el.classList.add('hidden'); return; }
  el.querySelector('span').textContent = 'Вес '+w+' кг автоматически переключил возрастную группу с «'+ageGroupLabel(previous)+
    '» на «'+ageGroupLabel(inferred)+'», меняя основание дозирования'+
    (lastPickedAge ? ' (вы ранее выбрали «'+ageGroupLabel(lastPickedAge)+'»)' : '')+
    '. Подтвердите выбор, если переключение ошибочно.';
  el.classList.remove('hidden');
}
function clearAgeInferenceNotice(){
  const el = $('age-infer-notice');
  if(el) el.classList.add('hidden');
}
function setActiveAge(a, inferredFromWeight){
  // Вывод из веса остаётся, но он больше не меняет основание дозирования молча.
  const previous = activeAge;
  activeAge = a;
  document.querySelectorAll('#age-group button').forEach(b=>{
    b.classList.toggle('active', b.dataset.age === a);
  });
  if(inferredFromWeight && previous !== a) showAgeInferenceNotice(inferredFromWeight.w, a, previous);
}
const KEY_MAP_RU_EN = {
  'й':'q','ц':'w','у':'e','к':'r','е':'t','н':'y','г':'u','ш':'i','щ':'o','з':'p','х':'[','ъ':']',
  'ф':'a','ы':'s','в':'d','а':'f','п':'g','р':'h','о':'j','л':'k','д':'l','ж':';','э':"'",
  'я':'z','ч':'x','с':'c','м':'v','и':'b','т':'n','ь':'m','б':',','ю':'.'
};
const HOMOGLYPHS_RU_EN = {
  'х':'h','с':'c','а':'a','в':'b','е':'e','к':'k','м':'m','о':'o','р':'p','т':'t'
};

function selectQuickDisease(code){
  if(!DB || !DB.recommendations) return;
  const found = DB.recommendations.find(r => (r.mkb10 || []).some(m => m.toUpperCase().startsWith(code.toUpperCase())));
  if(found){
    $('search').value = found.name;
    const clearBtn = $('search-clear');
    if(clearBtn) clearBtn.classList.remove('hidden');
    selectDisease(found);
  } else {
    $('search').value = code;
    handleSearch();
  }
}
function handleSearch(){
  const rawQ = $('search').value.trim();
  const clearBtn = $('search-clear');
  if(clearBtn) clearBtn.classList.toggle('hidden', rawQ.length === 0);
  const box = $('results-box');
  if(rawQ.length < 2){ box.classList.add('hidden'); return; }

  const qLower = rawQ.toLowerCase();
  const qClean = qLower.replace(/[\.\s\-_]/g, '');
  const qEn = qLower.split('').map(ch => KEY_MAP_RU_EN[ch] || HOMOGLYPHS_RU_EN[ch] || ch).join('').replace(/[\.\s\-_]/g, '');

  const filtered = DB.recommendations.filter(d=>{
    const mkbMatch = (d.mkb10 || []).some(m => {
      const mc = m.toLowerCase().replace(/[\.\s\-_]/g, '');
      return mc.includes(qClean) || mc.includes(qEn);
    });
    if(mkbMatch) return true;
    if(d.name.toLowerCase().includes(qLower)) return true;
    if(d.synonyms && d.synonyms.some(s=>s.toLowerCase().includes(qLower))) return true;
    if(d.cr_id && d.cr_id.toLowerCase().includes(qLower)) return true;
    return false;
  });

  box.innerHTML = '';
  filtered.forEach(d=>{
    const item = document.createElement('div');
    item.className = 'bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-100 dark:border-slate-700 cursor-pointer hover:bg-blue-50 dark:hover:bg-slate-700 transition-all font-bold text-slate-700 dark:text-slate-200 text-sm flex justify-between items-center';
    const matchedMkb = (d.mkb10 || []).find(m => {
      const mc = m.toLowerCase().replace(/[\.\s\-_]/g, '');
      return mc.includes(qClean) || mc.includes(qEn);
    });

    // Название/МКБ приходят из БД: собираем через textContent, а не innerHTML,
    // иначе значение из БД становится исполняемым HTML (stored XSS).
    const left = document.createElement('div');
    left.className = 'min-w-0';
    const topRow = document.createElement('div');
    topRow.className = 'flex items-center gap-1.5 flex-wrap';
    const nameEl = document.createElement('span');
    nameEl.textContent = d.name || '';
    topRow.appendChild(nameEl);
    if(matchedMkb){
      const code = document.createElement('span');
      code.className = 'bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-[10px] font-mono px-1.5 py-0.5 rounded font-black';
      code.textContent = matchedMkb;
      topRow.appendChild(code);
    }
    const meta = document.createElement('div');
    meta.className = 'text-[10px] text-slate-400 font-normal mt-0.5';
    meta.textContent = 'МКБ: '+(d.mkb10 || []).slice(0,3).join(', ')+((d.mkb10 || []).length > 3 ? '…' : '')+(d.cr_id ? ' • КР #'+d.cr_id : '');
    left.append(topRow, meta);
    const code = document.createElement('span');
    code.className = 'text-blue-500 font-mono text-xs ml-2 font-bold';
    code.textContent = (d.mkb10 || [])[0] || '';
    item.append(left, code);
    item.onclick = ()=>selectDisease(d);
    box.appendChild(item);
  });
  box.classList.toggle('hidden', filtered.length === 0);
}
function selectDisease(d){
  activeDisease = d;
  $('results-box').classList.add('hidden');
  $('search').value = '';
  const clearBtn = $('search-clear');
  if(clearBtn) clearBtn.classList.add('hidden');
  $('active-disease').classList.remove('hidden');
  $('active-title').textContent = d.name;
  $('active-mkb').textContent = 'МКБ-10: '+d.mkb10.join(', ');
  $('active-cr').textContent = (d.cr_id && d.cr_id !== '—' ? 'КР #'+d.cr_id : 'Протокол МЗ РФ') + (d.cr_year ? ' • '+d.cr_year : '');
  $('active-indications').textContent = d.indications ? 'Показания: '+d.indications.join('; ') : '';
  $('empty-state').classList.add('hidden');
  if(!applyDiseaseSourceGate(d)){
    updateHash();
    return;
  }
  $('scenario-step').classList.remove('hidden');
  $('drug-step').classList.add('hidden');
  $('form-step').classList.add('hidden');
  $('result-step').classList.add('hidden');
  renderScenarios();
  updateHash();
}
function applyDiseaseSourceGate(d){
  const block = $('source-calculation-block');
  if(!block) return true;
  const status = diseaseSourceStatus(d);
  block.dataset.sourceStatus = status;
  const blocked = status === 'blocked';
  if(blocked){
    block.className = 'mt-3 rounded-xl border-2 border-red-500 bg-red-50 dark:bg-red-950/40 px-3 py-3 text-[12px] font-bold text-red-800 dark:text-red-200';
    block.textContent = 'РАСЧЁТ ЗАБЛОКИРОВАН: ' + (d.calculation_block_reason || 'источник требует повторной верификации');
    block.classList.remove('hidden');
    $('scenario-step').classList.add('hidden');
    $('drug-step').classList.add('hidden');
    $('form-step').classList.add('hidden');
    $('result-step').classList.add('hidden');
    return false;
  }
  if(status === 'CALCULATOR_BOUND_VERIFIED'){
    block.className = 'mt-3 rounded-xl border border-emerald-500/50 bg-emerald-50/80 dark:bg-emerald-950/30 px-3 py-2 text-[11px] font-bold text-emerald-800 dark:text-emerald-200 flex items-center justify-between';
    block.innerHTML = '<span class="flex items-center gap-1.5"><i class="fas fa-check-circle text-emerald-600 dark:text-emerald-400"></i>Верифицировано по актуальной КР МЗ РФ (строгая привязка таблиц)</span><span class="badge bg-emerald-200 dark:bg-emerald-800 text-emerald-900 dark:text-emerald-100">VERIFIED</span>';
  } else if(status === 'UNVERIFIED' || status === 'unknown'){
    block.className = 'mt-3 rounded-xl border-2 border-amber-500 bg-amber-50 dark:bg-amber-950/40 px-3 py-2 text-[11px] font-black text-amber-900 dark:text-amber-200 flex items-center justify-between';
    block.innerHTML = '<span class="flex items-center gap-1.5"><i class="fas fa-exclamation-triangle text-amber-600 dark:text-amber-400"></i>Источник не верифицирован: расчёт справочный, сверьте схему с КР</span><span class="badge bg-amber-200 dark:bg-amber-800 text-amber-900 dark:text-amber-100">НЕ ВЕРИФИЦИРОВАНО</span>';
  } else {
    block.className = 'mt-3 rounded-xl border border-blue-200/80 bg-blue-50/60 dark:bg-blue-950/20 px-3 py-2 text-[11px] font-medium text-blue-900 dark:text-blue-200 flex items-center justify-between';
    // status приходит из БД, поэтому собираем баннер узлами: строковая склейка
    // в innerHTML превратила бы значение из БД в исполняемую разметку.
    const left = document.createElement('span');
    left.className = 'flex items-center gap-1.5';
    const icon = document.createElement('i');
    icon.className = 'fas fa-book-medical text-blue-600 dark:text-blue-400';
    const caption = document.createElement('span');
    caption.textContent = 'Справочный расчёт по данным клинических рекомендаций МЗ РФ (status: '+status+')';
    left.append(icon, caption);
    const badge = document.createElement('span');
    badge.className = 'badge bg-blue-100 dark:bg-blue-800 text-blue-800 dark:text-blue-100';
    badge.textContent = 'КР МЗ РФ';
    block.append(left, badge);
  }
  block.classList.remove('hidden');
  return true;
}
