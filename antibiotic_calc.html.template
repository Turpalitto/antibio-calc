<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AntibioAudit — КР МЗ РФ | Калькулятор доз</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = { darkMode: 'class' };
</script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
:root{--primary:#2563eb;--success:#10b981;--warning:#f59e0b;--danger:#ef4444;--slate-50:#f8fafc;--slate-100:#f1f5f9;--slate-800:#1e293b}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--slate-50);color:var(--slate-800);line-height:1.5}
.dark body{background:#0f172a;color:#e2e8f0}
.premium-card{background:#fff;border-radius:24px;border:1px solid rgba(226,232,240,.8);box-shadow:0 4px 6px -1px rgba(0,0,0,.02),0 10px 15px -3px rgba(0,0,0,.03);transition:all .3s}
.dark .premium-card{background:#1e293b;border-color:rgba(51,65,85,.8)}
.input-field{background:var(--slate-100);border:2px solid transparent;transition:all .2s;color:var(--slate-800)}
.dark .input-field{background:#0f172a;color:#e2e8f0;border-color:transparent}
.input-field:focus{background:#fff;border-color:var(--primary);outline:none;box-shadow:0 0 0 4px rgba(37,99,235,.1)}
.dark .input-field:focus{background:#0f172a}
.chip{cursor:pointer;border:2px solid var(--slate-100);transition:all .15s;font-weight:700;background:#fff}
.dark .chip{background:#1e293b;border-color:#334155;color:#e2e8f0}
.chip.active{background:var(--primary);color:#fff;border-color:var(--primary)}
.chip.line-1{border-color:#a7f3d0}
.chip.line-1.active{background:var(--success);border-color:var(--success)}
.chip.line-2{border-color:#bfdbfe}
.chip.line-2.active{background:var(--primary);border-color:var(--primary)}
.chip.line-0{border-color:#fde68a}
.chip.line-0.active{background:var(--warning);border-color:var(--warning);color:#78350f}
.drug-card{cursor:pointer;border:2px solid var(--slate-100);transition:all .2s;background:#fff}
.dark .drug-card{background:#1e293b;border-color:#334155}
.drug-card.active{border-color:var(--primary);background:#eff6ff}
.dark .drug-card.active{background:#1e3a8a;border-color:#3b82f6}
.scenario-card.active{border-color:var(--primary);background:#eff6ff}
.dark .scenario-card.active{background:#1e3a8a;border-color:#3b82f6}
.res-box{background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);box-shadow:0 20px 25px -5px rgba(37,99,235,.2)}
.inj-box{background:linear-gradient(135deg,#7c2d12 0%,#c2410c 100%);box-shadow:0 20px 25px -5px rgba(194,65,12,.25)}
.badge{font-size:10px;font-weight:800;padding:2px 8px;border-radius:6px;text-transform:uppercase}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.animate-in{animation:fadeIn .4s ease-out forwards}
.step{counter-increment:step}
.step::before{content:counter(step);display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;background:var(--primary);color:#fff;border-radius:50%;font-size:11px;font-weight:800;margin-right:8px;flex-shrink:0}
.steps{counter-reset:step;list-style:none;padding-left:0}
.steps li{padding:6px 0;display:flex;align-items:flex-start;font-size:13px;line-height:1.5}
.dilution-solvent{background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:10px 12px;font-size:12px;font-weight:600;color:#9a3412}
.dark .dilution-solvent{background:#451a03;border-color:#7c2d12;color:#fed7aa}
.scrollbar::-webkit-scrollbar{width:6px;height:6px}
.scrollbar::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:3px}
.route-tab.active{background:var(--primary);color:#fff;border-color:var(--primary)}
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(100px);background:#1e293b;color:#fff;padding:12px 20px;border-radius:12px;font-weight:600;font-size:13px;box-shadow:0 10px 25px rgba(0,0,0,.3);z-index:9999;opacity:0;transition:all .3s;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
@media (max-width:768px){
  .mobile-nav{display:flex}
  body{padding-bottom:70px}
}
@media print{
  body>*{display:none!important}
  #prescription-form{display:block!important}
  body{background:#fff!important;padding:0;margin:0}
  @page{size:A4;margin:8mm}
}
.print-only{display:none}
.drawer{position:fixed;top:0;right:-360px;width:360px;max-width:90vw;height:100vh;background:#fff;box-shadow:-10px 0 30px rgba(0,0,0,.15);z-index:1000;transition:right .3s;overflow-y:auto}
.dark .drawer{background:#1e293b}
.drawer.open{right:0}
.drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:999;opacity:0;pointer-events:none;transition:opacity .3s}
.drawer-overlay.open{opacity:1;pointer-events:auto}
.personal-banner{position:sticky;top:0;z-index:900;background:#7f1d1d;color:#fff;border:2px solid #fca5a5;box-shadow:0 8px 20px rgba(127,29,29,.25)}
.personal-status[data-state="ready"]{color:#047857}.personal-status[data-state="blocked"],.personal-status[data-state="error"]{color:#b91c1c}.personal-status[data-state="checking"]{color:#b45309}
.dark .personal-status[data-state="ready"]{color:#6ee7b7}.dark .personal-status[data-state="blocked"],.dark .personal-status[data-state="error"]{color:#fca5a5}.dark .personal-status[data-state="checking"]{color:#fcd34d}
.disclaimer-banner{margin:0;padding:10px 16px;background:#fffbeb;border-bottom:2px solid #f59e0b;color:#78350f;font-size:13px;line-height:1.5;width:100%;box-sizing:border-box;z-index:900}
.dark .disclaimer-banner{background:#422006;border-bottom-color:#f59e0b;color:#fef3c7}
@media print{ .disclaimer-banner{display:none!important} }
</style>
</head>
<body class="antialiased pb-12">
<div id="personal-mode-banner" class="personal-banner hidden no-print px-4 py-3 text-center text-xs font-black uppercase tracking-wider" role="alert" aria-live="assertive">
  OWNER_REVIEWED_EXPERIMENTAL — локальный режим врача-владельца; схема не имеет независимого production-одобрения. Проверяйте источник и расчёт.
</div>
<div class="max-w-3xl mx-auto px-4 md:px-6 pt-6">

  <header class="mb-6 no-print">
    <div class="flex items-center gap-3 flex-wrap">
      <div class="inline-flex items-center justify-center w-12 h-12 bg-white rounded-2xl shadow-sm border border-slate-100 dark:bg-slate-800 dark:border-slate-700">
        <i class="fas fa-user-md text-blue-600 text-xl"></i>
      </div>
      <div class="flex-1 min-w-0">
        <h1 class="text-xl md:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Antibio<span class="text-blue-600">Audit</span></h1>
        <p class="text-slate-400 text-[10px] font-bold mt-0.5 uppercase tracking-widest italic" id="header-stats">КР МЗ РФ • калькулятор</p>
      </div>
      <button id="btn-history" class="text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-blue-600 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-2" title="История расчётов">
        <i class="fas fa-history"></i>
      </button>
      <button id="btn-print" class="text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-blue-600 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-2" title="Печать/PDF">
        <i class="fas fa-print"></i>
      </button>
      <button id="btn-theme" class="text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-blue-600 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-2" title="Тема">
        <i class="fas fa-moon" id="theme-icon"></i>
      </button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mt-4">
      <input type="text" id="patient-name" placeholder="Ф.И.О. пациента" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
      <input type="text" id="patient-date" placeholder="Дата" class="input-field rounded-xl px-3 py-2 text-xs font-bold" onfocus="this.type='date'" onblur="if(!this.value)this.type='text'">
      <input type="number" id="patient-age" placeholder="Возраст" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
      <input type="text" id="doctor-name" placeholder="Врач" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
    </div>
  </header>

  <div class="space-y-5">

    <section class="premium-card p-4 md:p-6 no-print" id="personal-mode-control">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="text-[11px] font-black text-slate-500 dark:text-slate-300 uppercase tracking-widest">Личный режим врача</div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Опциональный локальный API v2. Обычный калькулятор работает независимо от API.</p>
        </div>
        <label class="inline-flex items-center gap-2 cursor-pointer shrink-0">
          <input id="personal-mode-toggle" type="checkbox" class="w-5 h-5 accent-blue-600" aria-controls="personal-mode-panel">
          <span class="text-[10px] font-black uppercase">Включить</span>
        </label>
      </div>
      <div id="personal-mode-panel" class="hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-700 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <input id="personal-owner-id" type="text" autocomplete="off" placeholder="owner_id (только локально)" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
          <input id="personal-session-token" type="password" autocomplete="off" placeholder="session_token (только локально)" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
          <select id="personal-pregnancy" class="input-field rounded-xl px-3 py-2 text-xs font-bold"><option value="unknown">Беременность: неизвестно</option><option value="no">Беременность: нет</option><option value="yes">Беременность: да</option></select>
          <input id="personal-renal" type="text" placeholder="Почки: СКФ/статус или «нет»" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
          <select id="personal-hepatic" class="input-field rounded-xl px-3 py-2 text-xs font-bold"><option value="unknown">Печень: неизвестно</option><option value="no">Печёночная недостаточность: нет</option><option value="yes">Печёночная недостаточность: да</option></select>
          <input id="personal-allergies" type="text" placeholder="Аллергии через запятую или «нет»" class="input-field rounded-xl px-3 py-2 text-xs font-bold">
          <input id="personal-current-meds" type="text" placeholder="Текущие препараты или «нет»" class="input-field rounded-xl px-3 py-2 text-xs font-bold md:col-span-2">
          <select id="personal-contra-cleared" class="input-field rounded-xl px-3 py-2 text-xs font-bold"><option value="no">Противопоказания: не проверены</option><option value="yes">Противопоказания: проверены</option></select>
          <select id="personal-interactions-reviewed" class="input-field rounded-xl px-3 py-2 text-xs font-bold"><option value="no">Взаимодействия: не проверены</option><option value="yes">Взаимодействия: проверены</option></select>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
          <button id="personal-request" type="button" class="rounded-xl bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 text-[11px] font-black uppercase tracking-wider">Получить кандидатов</button>
          <button id="personal-health" type="button" class="rounded-xl bg-slate-700 hover:bg-slate-800 text-white px-4 py-2 text-[11px] font-black uppercase tracking-wider">Проверить режим</button>
          <span id="personal-api-status" class="personal-status text-[11px] font-bold" data-state="idle" role="status">API не проверен</span>
        </div>
        <details class="rounded-2xl border border-slate-200 dark:border-slate-700 p-4 text-xs">
          <summary class="cursor-pointer font-black uppercase tracking-widest text-slate-600 dark:text-slate-300">Первичная настройка и аттестация схем</summary>
          <div class="mt-4 space-y-4">
            <div class="rounded-xl bg-amber-50 dark:bg-amber-950/20 p-3 text-[11px] text-amber-900 dark:text-amber-200">Регистрация выполняется один раз. Токен показывается один раз и не сохраняется приложением. Аттестация допускается только после вашей точной сверки страницы, цитаты, дозы и привязки к калькулятору.</div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
              <input id="owner-register-id" class="input-field rounded-xl px-3 py-2" placeholder="owner_id">
              <input id="owner-register-name" class="input-field rounded-xl px-3 py-2" placeholder="Ф.И.О. врача-владельца">
              <input id="owner-register-role" class="input-field rounded-xl px-3 py-2" value="physician" placeholder="Профессиональная роль">
              <input id="owner-register-org" class="input-field rounded-xl px-3 py-2" value="independent practice" placeholder="Организация">
            </div>
            <button id="owner-register" type="button" class="rounded-xl bg-emerald-700 text-white px-4 py-2 font-black uppercase">Зарегистрировать локально</button>
            <div class="rounded-2xl border-2 border-blue-300 dark:border-blue-800 p-4 space-y-3">
              <div class="font-black text-blue-900 dark:text-blue-200">Дозировки, извлечённые из актуального PDF КР</div>
              <div class="text-[11px] text-slate-600 dark:text-slate-400">Приложение показывает точную строку таблицы, страницу и хеш PDF. Выберите допустимый вариант расчёта и подтвердите его одной кнопкой. Неоднозначные строки блокируются.</div>
              <div class="flex flex-col md:flex-row gap-2">
                <input id="owner-guideline-id" class="input-field rounded-xl px-3 py-2 flex-1" value="314" placeholder="Номер КР, например 314">
                <button id="owner-load-extracted" type="button" class="rounded-xl bg-blue-700 text-white px-4 py-2 font-black uppercase">Загрузить из PDF КР</button>
              </div>
              <div id="owner-extracted-candidates" class="space-y-3"></div>
            </div>
            <details class="rounded-xl border border-slate-200 dark:border-slate-700 p-3">
              <summary class="cursor-pointer font-bold">Ручной JSON (резервный режим)</summary>
              <div class="mt-3 space-y-2">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
              <textarea id="owner-regimen-json" rows="9" class="input-field rounded-xl px-3 py-2 font-mono" placeholder='regimen_payload JSON: идентификаторы, dose, population, safety, provenance, terminology_mappings, alternatives'></textarea>
              <textarea id="owner-binding-json" rows="9" class="input-field rounded-xl px-3 py-2 font-mono" placeholder='calculator_binding JSON: disease_id, scenario_id, line_number, route, drug_ref/combo_ref, regimen_label/regimen_index, binding_version'></textarea>
              <input id="owner-source-page" type="number" min="1" class="input-field rounded-xl px-3 py-2" placeholder="Страница PDF">
              <input id="owner-pdf-sha" class="input-field rounded-xl px-3 py-2 font-mono" placeholder="sha256:... PDF">
              <textarea id="owner-source-quote" rows="3" class="input-field rounded-xl px-3 py-2 md:col-span-2" placeholder="Точная цитата из КР"></textarea>
              <input id="owner-rationale" class="input-field rounded-xl px-3 py-2 md:col-span-2" placeholder="Обоснование аттестации">
            </div>
            <button id="owner-attest" type="button" class="rounded-xl bg-amber-700 text-white px-4 py-2 font-black uppercase">Аттестовать одну схему</button>
              </div>
            </details>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
              <input id="owner-event-ids" class="input-field rounded-xl px-3 py-2 md:col-span-2" placeholder="event_id через запятую">
              <input id="owner-bundle-version" class="input-field rounded-xl px-3 py-2" placeholder="Версия bundle, например owner-1.0">
              <input id="owner-stale-days" type="number" min="1" max="365" value="30" class="input-field rounded-xl px-3 py-2" placeholder="Срок актуальности, дней">
              <button id="owner-build" type="button" class="rounded-xl bg-red-700 text-white px-4 py-2 font-black uppercase md:col-span-2">Собрать и активировать bundle</button>
            </div>
            <pre id="owner-workflow-result" class="rounded-xl bg-slate-950 text-slate-100 p-3 overflow-auto whitespace-pre-wrap">Локальный workflow не запускался.</pre>
          </div>
        </details>
        <div id="personal-candidates" class="hidden space-y-2" aria-live="polite"></div>
        <div id="personal-trace-panel" class="hidden rounded-2xl border border-slate-200 dark:border-slate-700 p-4 text-xs space-y-3">
          <div class="font-black uppercase tracking-widest text-slate-500">Trace / источник</div>
          <div id="personal-trace-content" class="space-y-2 text-slate-700 dark:text-slate-300 whitespace-pre-wrap"></div>
        </div>
      </div>
    </section>

    <section class="premium-card p-4 md:p-6 no-print">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div>
          <label class="text-[11px] font-black text-slate-400 uppercase tracking-widest mb-2 block">1. Вес</label>
          <div class="relative">
            <input type="number" id="weight" step="0.1" placeholder="0.0" class="input-field w-full rounded-2xl px-4 py-3 text-2xl md:text-3xl font-extrabold" oninput="onWeightChange()">
            <div class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-sm">кг</div>
          </div>
        </div>
        <div class="col-span-2 md:col-span-1">
          <label class="text-[11px] font-black text-slate-400 uppercase tracking-widest mb-2 block">Возрастная группа</label>
          <div id="age-group" class="grid grid-cols-3 gap-1">
            <button data-age="neonate" class="chip rounded-xl py-2 text-[10px]">Новор.<br><span class="text-[9px] opacity-70">0-28д</span></button>
            <button data-age="child" class="chip active rounded-xl py-2 text-[10px]">Дети<br><span class="text-[9px] opacity-70">1м-17л</span></button>
            <button data-age="adult" class="chip rounded-xl py-2 text-[10px]">Взр.<br><span class="text-[9px] opacity-70">&gt;18л</span></button>
          </div>
        </div>
      </div>
      <div id="weight-warn" class="hidden mt-3 text-[11px] font-bold text-red-600 bg-red-50 dark:bg-red-900/20 rounded-lg px-3 py-2"><i class="fas fa-exclamation-triangle mr-1"></i><span></span></div>
    </section>

    <section class="premium-card p-4 md:p-6 no-print">
      <label class="text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 block">2. Нозология (МКБ-10 / название)</label>
      <div class="relative">
        <i class="fas fa-search absolute left-4 md:left-5 top-1/2 -translate-y-1/2 text-slate-400"></i>
        <input type="text" id="search" placeholder="Поиск: отит, J18, пневмония, сифилис..." class="input-field w-full rounded-2xl py-3 md:py-4 pl-10 md:pl-12 pr-4 font-bold text-slate-700 text-sm" oninput="handleSearch()">
      </div>
      <div id="results-box" class="hidden mt-3 space-y-2 max-h-72 overflow-y-auto pr-1 scrollbar"></div>
      <div id="active-disease" class="hidden mt-4 p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 rounded-2xl">
        <div class="flex justify-between items-start">
          <div class="flex-1 min-w-0">
            <span id="active-title" class="font-bold text-blue-900 dark:text-blue-300 text-sm block mb-1"></span>
            <span id="active-mkb" class="text-[10px] font-black text-blue-400 uppercase"></span>
            <span id="active-cr" class="text-[10px] font-bold text-slate-400 ml-2"></span>
          </div>
          <button onclick="resetDisease()" class="text-blue-300 hover:text-red-500"><i class="fas fa-times-circle text-lg"></i></button>
        </div>
        <div id="active-indications" class="mt-2 text-[11px] text-blue-900/80 dark:text-blue-300/80 font-semibold"></div>
        <div id="source-calculation-block" class="hidden mt-3 rounded-xl border-2 border-red-500 bg-red-50 dark:bg-red-950/40 px-3 py-3 text-[12px] font-black text-red-800 dark:text-red-200"></div>
        <div id="guideline-links" class="hidden mt-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-3"></div>
      </div>
    </section>

    <div id="scenario-step" class="hidden animate-in no-print">
      <label class="text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 ml-2 block">3. Клинический сценарий</label>
      <div id="scenario-list" class="space-y-2"></div>
    </div>

    <div id="drug-step" class="hidden animate-in no-print">
      <label class="text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 ml-2 block">4. Препарат (линии КР)</label>
      <div id="drug-list" class="space-y-2"></div>
    </div>

    <div id="form-step" class="hidden animate-in space-y-4 no-print">
      <section class="premium-card p-4 md:p-6">
        <div class="flex items-center justify-between mb-3">
          <label class="text-[11px] font-black text-slate-400 uppercase tracking-widest">5. Лекарственная форма</label>
          <div id="route-tabs" class="flex gap-1"></div>
        </div>
        <div id="form-grid" class="grid grid-cols-2 md:grid-cols-3 gap-2"></div>
