  if(singleMg <= 0 && dailyMg <= 0){
    signa = reg.duration_note || reg.regimen_label || (form.notes ? form.notes + ': ' : '') + 'применять по схеме клинических рекомендаций';
  } else if(currentRouteGroup === 'topical' || form.form_type === 'topical'){
    signa = 'Применять наружно/местно: ' + (form.notes ? form.notes + ' ' : '') + form.concentration + (reg.freq_per_day ? ' ' + reg.freq_per_day + ' раза в день' : '');
  } else if(form.form_type === 'tablet' || form.form_type === 'capsule'){
    const tabsPerDose = singleMg / parseFloat(form.concentration);
    signa = 'По '+(isNaN(tabsPerDose) ? '' : tabsPerDose.toFixed(1).replace(/\.0$/,'')+' ')+latinForm+' '+reg.freq_per_day+' раза в день, '+routeRu;
  } else if(form.concentration_mg_per_ml){
    const ml = singleMg / form.concentration_mg_per_ml;
    signa = 'По '+ml.toFixed(1)+' мл ('+form.concentration+') внутрь '+reg.freq_per_day+' раза в день';
  } else {
    signa = 'По '+fmtDose(singleMg, unit)+' '+routeRu+', '+reg.freq_per_day+' раза в день';
  }
  if(currentRouteGroup === 'iv' && activeRouteKey === 'iv_infusion') signa += ', капельно за 30 мин';
  if(currentRouteGroup === 'iv' && activeRouteKey === 'iv_bolus') signa += ', медленно за 5 мин';
  signaEl.textContent = signa;

  // Course
  $('rx-course').textContent = 'Курс: '+(reg.duration_days || '—')+' дней'+(reg.duration_note?'. '+reg.duration_note:'');

  // Injection preparation
  const injEl = $('rx-injection-details');
