# Copy to a local .env only when your launcher loads it. Never commit .env.
# Required variables depend on configured LLM provider chain.
ANTIBIO_ANTHROPIC_API_KEY=<set-in-local-secret-store>
ANTIBIO_DEEPSEEK_API_KEY=<set-in-local-secret-store>
ANTIBIO_OPENROUTER_API_KEY=<optional>
ANTIBIO_OPENAI_API_KEY=<optional>
ANTIBIO_GEMINI_API_KEY=<optional>

# External corpus contract. Production PDFs stay outside Git.
ANTIBIO_CORPUS_DIR=C:\clinrec_downloader

# Optional: only set this if heavyweight extraction deps (DocLayout-YOLO,
# Table Transformer, RapidTable, transformers) live in a site-packages
# directory outside your active Python environment. Leave empty otherwise —
# normal imports from the active environment are used by default.
ANTIBIO_EXTERNAL_SITE_PACKAGES=
