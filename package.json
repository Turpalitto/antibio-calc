{
  "name": "antibio-calc",
  "version": "0.1.0",
  "private": true,
  "description": "Offline single-page physician antibiotic dose calculator: static shell, PWA service worker and clinical DB tooling",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node server.js",
    "validate": "node db/validate_db.js",
    "validate:json": "node db/validate_db.js --json",
    "build": "python3 db/build_html.py",
    "test": "npm run validate && .venv/bin/python -m pytest clinical_engine/tests/test_build_reproducibility.py -q"
  }
}
