{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnerFidelityEvent",
  "description": "RC-030 owner source-fidelity review event. Immutable once created; corrections are new events referencing the prior one via previous_event_id/supersedes_event_id. Never implies clinical approval or calculation eligibility.",
  "type": "object",
  "required": [
    "event_id", "event_version", "created_at", "reviewer_id", "unit_id",
    "regimen_id", "regimen_version", "canonical_verdict", "ui_action", "note",
    "source_packet_hash", "pdf_hash", "parser_version", "interface_version", "test_event"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_version": {"type": "integer", "const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "regimen_id": {"type": "string", "minLength": 1},
    "regimen_version": {"type": "integer", "minimum": 1},
    "canonical_verdict": {
      "type": "string",
      "enum": [
        "CORRECT_EXPLICIT_PER_DAY", "CORRECT_EXPLICIT_PER_DOSE", "CORRECT_FIXED_DAILY",
        "CORRECT_FIXED_SINGLE", "CORRECT_RANGE_DAILY", "CORRECT_RANGE_SINGLE",
        "WRONG_DOSE_ANCHOR", "WRONG_SEMANTIC_MARKER", "WRONG_FREQUENCY_LINK",
        "WRONG_ALTERNATIVE", "WRONG_AGE_GROUP", "WRONG_TABLE_ROW",
        "SOURCE_INCOMPLETE", "SOURCE_CORRUPTED", "TABLE_CONTEXT_REQUIRED",
        "REMAINS_AMBIGUOUS", "NOT_A_DOSABLE_REGIMEN"
      ]
    },
    "ui_action": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "source_packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pdf_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parser_version": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "parser_semantic_type": {"type": "string"},
    "interface_version": {"type": "string", "minLength": 1},
    "previous_event_id": {"type": ["string", "null"]},
    "supersedes_event_id": {"type": ["string", "null"]},
    "test_event": {"type": "boolean"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "canonical_verdict": {
            "enum": [
              "CORRECT_EXPLICIT_PER_DAY", "CORRECT_EXPLICIT_PER_DOSE", "CORRECT_FIXED_DAILY",
              "CORRECT_FIXED_SINGLE", "CORRECT_RANGE_DAILY", "CORRECT_RANGE_SINGLE"
            ]
          }
        }
      },
      "then": {"properties": {"note": {"minLength": 1}}}
    }
  ]
}
